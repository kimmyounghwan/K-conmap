      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "⑨ GitHub 에 올리기",
      "dependsOrder": "sequence",
      "dependsOn": [
        "⑨-1 변경분 담기",
        "⑨-2 커밋",
        "⑨-3 푸시"
      ],
      "problemMatcher": []
    },
    {
      "label": "⑨-1 변경분 담기",
      "type": "shell",
      "command": "git",
      "args": [
        "add",
        "-A"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "⑨-2 커밋",
      "type": "shell",
      "command": "git",
      "args": [
        "commit",
        "-m",
        "업데이트",
        "--allow-empty"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
