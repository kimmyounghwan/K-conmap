{
  "version": "2.0.0",
  "//": "명령을 세미콜론으로 잇지 않습니다. cmd.exe 에서는 ; 가 구분자가 아니라 그냥 인자로 넘어가 실패합니다. 여러 단계는 dependsOn 으로 이어붙입니다.",
  "tasks": [
    {
      "label": "🔎 환경 점검 (안 될 때 이것부터)",
      "detail": "node / npm / python / firebase 가 깔려 있는지 한 번에 확인합니다.",
      "type": "shell",
      "command": "node -v; npm -v; python --version; firebase --version",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "⓪ 최초 1회 — 패키지 설치",
      "detail": "pip 와 npm 을 순서대로 설치합니다. 처음 한 번만.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "⓪-1 파이썬 패키지",
        "⓪-2 npm 패키지"
      ],
      "problemMatcher": []
    },
    {
      "label": "⓪-1 파이썬 패키지",
      "type": "shell",
      "command": "pip",
      "args": [
        "install",
        "-r",
        "requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "⓪-2 npm 패키지",
      "type": "shell",
      "command": "npm",
      "args": [
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "① 빠른 갱신 (공고만 새로 받아 배포)",
      "detail": "평소 이걸 쓰세요. 2~5분. 집계는 건너뜁니다.",
      "type": "shell",
      "command": "python",
      "args": [
        "run_all.py",
        "--quick"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "② 전체 실행 (집계까지 다시)",
      "detail": "3년치를 새로 집계합니다. 8~12분. 새 자료를 넣었을 때만.",
      "type": "shell",
      "command": "python",
      "args": [
        "run_all.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "③ 미리보기 서버 (npm run dev)",
      "detail": "저장하면 브라우저가 바로 바뀝니다. 끌 때는 터미널의 휴지통 아이콘.",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "④ 배포만 (빌드 + firebase)",
      "detail": "빌드하고 사이트에 올립니다.",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "deploy"
      ],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "④-1 빌드만 (오류 확인용)",
