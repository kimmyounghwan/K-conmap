{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "① 빠른 갱신 (공고만 새로 받아 배포)",
      "detail": "평소 이걸 쓰세요. 2~5분. 집계는 건너뜁니다.",
      "type": "shell",
      "command": "python",
      "args": [
        "run_all.py",
        "--quick"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "② 전체 실행 (집계까지 다시)",
      "detail": "3년치를 새로 집계합니다. 8~12분. 새 자료를 넣었을 때만.",
      "type": "shell",
      "command": "python",
      "args": [
        "run_all.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "③ 미리보기 서버 (npm run dev)",
      "detail": "코드를 저장하면 브라우저가 바로 바뀝니다. 끌 때는 휴지통 아이콘.",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "④ 배포만 (firebase deploy)",
      "detail": "이미 빌드해둔 것을 올리기만 합니다.",
