      "command": "npm",
      "args": [
        "run",
        "deploy"
      ],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "⑤ inbox 자료만 반영",
      "detail": "inbox 폴더에 넣은 CSV·엑셀을 읽어 정리합니다.",
