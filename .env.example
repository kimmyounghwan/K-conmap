# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요.
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다.

# 공공데이터포털에서 발급받은 조달청 오픈API 키 (디코딩된 일반 인증키)
G2B_API_KEY=여기에_붙여넣기

# 사이트 주소 — 도메인을 붙이면 이 값을 바꾸세요 (sitemap.xml 에 쓰입니다)
SITE_URL=https://k-conmap.com

# 사이트맵에 실을 발주기관 페이지 수. 색인이 붙는 걸 보면서 천천히 올리세요.
SITEMAP_AGENCIES=800
