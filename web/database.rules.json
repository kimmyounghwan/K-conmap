          "s": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "p": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "t": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "m": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
