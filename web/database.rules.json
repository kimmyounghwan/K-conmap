    },
    "eq_rows": {
      "$c": {
        ".read": "auth != null && root.child('eq_pins').child($c).exists() && root.child('eq_keys').child($c).child(auth.uid).val() === root.child('eq_pins').child($c).val()",
        ".write": "auth != null && root.child('eq_pins').child($c).exists() && root.child('eq_keys').child($c).child(auth.uid).val() === root.child('eq_pins').child($c).val()",
        "$id": {
          ".validate": "newData.hasChildren(['d','cl','q','amt','at'])",
          "d": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "dr": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "dn": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "e": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "cl": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "cn": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "s": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "q": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "un": { ".validate": "newData.isString() && newData.val().length <= 6" },
          "u": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
          "amt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000" },
          "oil": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000" },
