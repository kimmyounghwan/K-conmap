    // ───── ⚠️ 위험성평가 (2026-09-29, pages/RiskBook.jsx · lib/위험성.js · lib/장부.js ns 'rk') ─────
    // 별지 1~5 (최초·정기 / 수시 4주·1주·1일 / 회의 결과 / 교육 결과 / 성과측정표)를 한 장부에.
    // 서류 한 장 = rk_docs/{코드}/{번호} {k 종류, d 작성일, t 목록 제목, j 내용(JSON 글)}.
    // 회의·교육 사진은 rk_pics/{코드}/{서류번호} {a, b} — 브라우저에서 줄인 JPEG(data:) · 서류를 열 때만 받습니다.
    "rk_pins": {
      ".read": false,
      "$c": {
        ".write": "auth != null && !data.exists() && $c.matches(/^[A-Z0-9]{9}$/)",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "rk_keys": {
      "$c": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.val() === root.child('rk_pins').child($c).val())"
        }
      }
    },
    "rk_books": {
      "$c": {
        ".read": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        ".write": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        ".validate": "newData.hasChildren(['name','at'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "co": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "who": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "upd": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "del": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "$other": { ".validate": false }
      }
    },
    "rk_docs": {
      "$c": {
        ".read": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        ".write": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        "$id": {
          ".validate": "newData.hasChildren(['k','d','j','at'])",
          "k": { ".validate": "newData.isString() && newData.val().matches(/^(1|2m|2w|2d|3|4|5)$/)" },
          "d": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "t": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "j": { ".validate": "newData.isString() && newData.val().length <= 150000" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "upd": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "rk_pics": {
      "$c": {
        ".read": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        ".write": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        "$id": {
          ".validate": "newData.hasChildren(['at'])",
          "a":  { ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 1500000" },
          "b":  { ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 1500000" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "rk_trash": {
      "$c": {
        ".read": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        ".write": "auth != null && root.child('rk_pins').child($c).exists() && root.child('rk_keys').child($c).child(auth.uid).val() === root.child('rk_pins').child($c).val()",
        "$t": {
          ".validate": "newData.hasChildren(['p','k','v','at'])",
          "p":  { ".validate": "newData.isString() && newData.val().matches(/^(docs)$/)" },
          "k":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "v":  { ".validate": "newData.hasChildren()" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    }
  }
