// K-건설맵 RTDB 규칙
//
// ⚠️ 이 파일은 기존 Streamlit(k-conmap) 규칙에 구인구직을 더한 "병합본"입니다.
//    stats / sarasa / archive_* / service_* 를 지우면 돌아가는 사이트가 깨집니다.
//
// ⚠️ 루트를 "auth != null" 로만 두면, 익명 로그인을 켜는 순간
//    누구나 DB 전체를 읽고 쓸 수 있게 됩니다. 익명은 반드시 제외합니다.
//
// 원래 규칙 백업: _임시/rtdb_rules_백업_20260830.json

{
  "rules": {
    // 🔒 2026-09-18 — 뿌리는 **아무도** 못 읽고 못 씁니다.
    //    전에는 «익명이 아닌 로그인» 이면 DB 전체를 읽고 쓸 수 있었습니다. 지금은
    //    그런 로그인을 쓰는 데가 한 곳도 없는데(사이트는 signInAnonymously 하나뿐,
    //    tools/qna_mail.py·quote_mail.py 는 서비스 계정이라 규칙을 지나칩니다),
    //    구글 로그인 같은 걸 한 번이라도 켜는 순간 «아무 구글 계정이나» DB 주인이 됩니다.
    //    열어 둘 까닭이 없어 닫았습니다. 필요한 칸은 아래에서 하나씩 엽니다.
    //    ⚠️ 옛 Streamlit 이 쓰던 users·bid_master·announcements·archive_*·service_*·
    //       backup_notices 는 여기에 걸려 전부 잠깁니다. 그 사이트는 이미 없습니다.
    //    ⚠️ 서비스 계정(함수·메일 도구)은 규칙과 상관없이 그대로 됩니다.
    ".read": false,
    ".write": false,

    // ───── 옛 Streamlit 이 쓰던 노드 ─────
    // 🚨 2026-09-18 — 파이어베이스가 「안전하지 않은 규칙」 메일을 보냈습니다. **여기였습니다.**
    //    이 두 칸이 «.read: true, .write: true» 였습니다. 즉 **주소만 알면 누구나
    //    아무 것이나 써 넣을 수 있었습니다.** DB 주소는 사이트 자바스크립트에 들어 있으니
    //    사실상 공개된 주소입니다. 종량제(Blaze)라 남이 자료를 들이부으면 요금이 붙고,
    //    있던 값을 지워 버릴 수도 있었습니다.
    //
    //    실측하고 닫았습니다:
    //      · stats  — 방문 세는 값 네 개뿐. 마지막 기록이 **2026-04** 로 다섯 달째 멈춰 있었습니다.
    //      · sarasa — sarasa/deals 에 쇼핑몰 링크 15개. sarasa.kr 은 파이어베이스를 아예 안 부릅니다(실측).
    //      · 옛 사이트 k-conmap.streamlit.app 은 **이미 없습니다**(「앱이 없거나 권한이 없습니다」).
    //    ⇒ 쓰기는 둘 다 막습니다. 읽기는 sarasa 만 열어 둡니다(공개 쇼핑 링크라 해가 없고,
    //      혹시 읽는 데가 있어도 안 깨지게).
    //    ⚠️ 값은 **지우지 않았습니다.** 지금 값은 CLAUDE.md 8절 56 에 적어 두었습니다.
    //    ⚠️ 여기에 다시 쓸 일이 생기면 «.write: true» 로 열지 말고, 서비스 계정(규칙을 지나칩니다)을
    //       쓰거나 모양·크기를 검사하는 .validate 를 붙여 여십시오.
    "stats":  { ".read": false, ".write": false },
    "sarasa": { ".read": true,  ".write": false },
    "archive_1st": { ".indexOn": ["날짜"] },
    "archive_live": { ".indexOn": ["공고일자"] },
    "service_1st": { ".indexOn": ["날짜"] },
    "service_live": { ".indexOn": ["공고일자"] },

    // ───── 💬 묻고 답하기 (2026-09-15) ─────
    // 소장님: 「건설맵 이용자가 이용할 수 있는 게시판도 있어야 하지 않아」 · 「묻고 답하기 형식으로」
    //
    // 구인구직과 같은 얼개입니다 — 누구나 읽고, 익명 로그인한 사람만 쓰고,
    // 지우는 건 글쓴이 브라우저(uid)만. 삭제 비밀번호는 해시로만 둡니다.
    //
    // ⚠️ 연락처 칸이 «없습니다». 공개 게시판에 전화번호를 적으면 광고 전화가 갑니다.
    //    연락처가 필요한 이야기는 내역서 문의함(quotes)으로 갑니다.
    // 🔑 2026-09-27 «내 글 되찾기» — 소장님: 「비번을 풀고, 간단히 수정하게 하면 … 그래서 다시 기억하게 한다면」
    //    다른 기기·기록 삭제 뒤에도 글 쓸 때 정한 4자리로 «옛 나»(qna_who/{지금 uid}.r)를 잇습니다.
    //    이어진 기기는 옛 번호(r)로 쓴 글을 고치고 지우며, 새 글도 그 번호로 씁니다(별명이 같아짐).
    //    ⚠️ uid 칸은 이제 «내 번호» 이거나 «이어진 옛 번호» 만 받습니다(전엔 아무 글자나 됐습니다).
    // 🙈 2026-10-01 사랑방 «몰래 차단» (G99 → G101) — 소장님: 「기계를 막아줘」 → 「캐시 지우는데 몇 초면 되는데...의미가 없잖아」 → 고르심 «몰래 차단»
    //    qna_block/{uid} 에 오른 기기(익명 번호)는 글(qna) · 답글(qna_a)을 쓸 수는 있지만 반드시 sb:true 가 붙어야 합니다(.validate).
    //    sb 글은 화면이 쓴 기기 · 운영자에게만 보여 줍니다 — 막힌 줄 몰라야 기록을 지우고 다시 오지 않습니다.
    //    qna_block 은 소장님 PC 의 파이어베이스 명령(관리자 권한)으로만 넣고 뺍니다. 그 기기만 «자기 칸» 을 읽어 sb 를 붙입니다(lib/차단.js).
    "qna_block": {
      ".read": false,
      ".write": false,
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "qna": {
      ".read": true,
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid || data.child('uid').val() === root.child('qna_who').child(auth.uid).child('r').val() )",
        ".validate": "newData.hasChildren(['t','nick','uid','at']) && ( !root.child('qna_block').child(auth.uid).exists() || newData.child('sb').val() === true )",
        "t":       { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
        "b":       { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "nick":    { ".validate": "newData.isString() && newData.val().length <= 20 && ( newData.val() !== 'K-건설맵' || auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1' )" },
        "uid":     { ".validate": "newData.isString() && ( newData.val() === auth.uid || newData.val() === root.child('qna_who').child(auth.uid).child('r').val() )" },
        // ✏️ 고친 때 — 이용자가 제 글을 고치면 붙습니다(«고침» 표시)
        "e":       { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "at":      { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "deleted": { ".validate": "newData.isBoolean()" },
        // 🙈 몰래 차단(G101) — qna_block 에 오른 기기의 글. 쓴 기기 · 운영자에게만 보임(화면이 거름)
        "sb":      { ".validate": "newData.isBoolean()" },
        "$other":  { ".validate": false }
      }
    },

    // 답변. **누구나 답니다** — 가입도 로그인도 없습니다. 그건 그대로입니다.
    //
    // 🚨 2026-09-17 — 「K-건설맵 답변」 표(op)가 **아무나 달 수 있게 열려 있었습니다.**
    //    전에는 «op 가 참/거짓이기만 하면» 통과였습니다. 화면에서 열쇠말을 맞춰 보긴 했지만
    //    그 비교는 **브라우저 «안에서만»** 했습니다 — 개발자도구를 아는 사람은 그냥 표를 답니다.
    //    그 표를 달고 틀린 답이 올라가면 이용자는 «현장소장이 답했다» 고 읽습니다.
    //
    // → 이제 **서버(이 규칙)가 uid 를 봅니다.** 운영자 브라우저가 아니면 op 를 참으로 못 넣습니다.
    //   소장님: 「답글에 비번이 왜 필요해.. 유료만 필요하지」 — 맞는 말씀이라 **열쇠말을 없앴습니다.**
    //
    // ⚠️ uid 를 여기 적어도 안전합니다. 익명 로그인은 «원하는 uid 로» 로그인할 수 없습니다 —
    //    uid 를 안다고 그 사람이 될 수 없습니다. (파이어베이스에서 흔히 쓰는 방식입니다)
    // ⚠️ 브라우저 기록을 지우면 uid 가 바뀝니다. 그러면 여기에 새 번호를 «더하고» 다시 올리면 됩니다.
    //    기기를 바꾸실 때도 마찬가지입니다 — 사랑방 「이 사랑방 쓰는 법」 맨 아래에
    //    그 브라우저의 번호가 적혀 있습니다.
    // ⚠️ 화면(Qna.jsx)의 OPS 목록과 **반드시 같아야** 합니다. 한쪽만 고치면
    //    화면은 표를 붙이려 하는데 서버가 막아 «올리지 못했습니다» 가 납니다.
    "qna_a": {
      ".read": true,
      "$qid": {
        "$aid": {
          ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid || data.child('uid').val() === root.child('qna_who').child(auth.uid).child('r').val() )",
          ".validate": "newData.hasChildren(['b','nick','uid','at']) && ( !root.child('qna_block').child(auth.uid).exists() || newData.child('sb').val() === true )",
          "b":       { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 2000" },
          "nick":    { ".validate": "newData.isString() && newData.val().length <= 20 && ( newData.val() !== 'K-건설맵' || auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1' )" },
          // ⛔ 운영자 브라우저만 참으로 넣을 수 있습니다. 나머지는 거짓이거나 아예 없어야 합니다.
          //    ⚠️ 번호를 «여기 규칙 안에» 적습니다. DB 에 명단을 따로 두면 그 명단을 넣을 길이
          //       없습니다(3_규칙올리기.bat 은 규칙만 올립니다). 기기를 더하실 땐 || 로 이어 붙이고
          //       그 배치파일을 한 번 돌리면 끝입니다.
          "op":      { ".validate": "newData.isBoolean() && ( newData.val() === false || auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1' )" },
          "uid":     { ".validate": "newData.isString() && ( newData.val() === auth.uid || newData.val() === root.child('qna_who').child(auth.uid).child('r').val() )" },
          "at":      { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "sb":      { ".validate": "newData.isBoolean()" },
          "$other":  { ".validate": false }
        }
      }
    },

    // 💬 «이 글은 메일로 알렸다» 표시. 기계(tools/qna_mail.py)만 씁니다 —
    //    서비스 계정은 규칙을 지나쳐 쓰므로 여기는 둘 다 막아 둡니다.
    //    ⚠️ 표시를 글(qna) «안에» 두지 않습니다 — $other: .validate false 와 부딪히고,
    //       이용자 글을 기계가 고치는 것도 맞지 않습니다.
    "qna_mail": { ".read": false, ".write": false },

    // 🔔 2026-09-30(G73) 사랑방 답글 알림 — 소장님 「내가 답글달면 의무적으로 가게 해줘」 · 「사이트 안, 폰 알림창도 뜨게 해줘」
    //    noti/{번호}/{답글} : 함수(qnaReplyNotify)가 씁니다. 그 번호의 주인(지금 uid 또는 되찾아 이어진 옛 번호 r)만 읽고,
    //                         «봤음(seen)» 표시와 지우기만 할 수 있습니다. 남의 알림은 못 읽습니다.
    //    push/{번호}/{기기} : 폰 알림 주소(브라우저 푸시 구독). 주인만 넣고 지우며, 아무도 못 읽습니다(함수만 읽음).
    //    push_keys         : 웹 푸시 열쇠 — 함수가 처음 필요할 때 만들어 둡니다. 읽기 · 쓰기 모두 막음(공개 열쇠는 pushKey 창구로).
    "noti": {
      "$r": {
        ".read": "auth != null && ( auth.uid === $r || root.child('qna_who').child(auth.uid).child('r').val() === $r )",
        "$id": {
          ".write": "auth != null && !newData.exists() && ( auth.uid === $r || root.child('qna_who').child(auth.uid).child('r').val() === $r )",
          "seen": {
            ".write": "auth != null && data.parent().exists() && ( auth.uid === $r || root.child('qna_who').child(auth.uid).child('r').val() === $r )",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "push": {
      "$r": {
        "$sid": {
          ".write": "auth != null && ( auth.uid === $r || root.child('qna_who').child(auth.uid).child('r').val() === $r )",
          ".validate": "!newData.exists() || newData.hasChildren(['s', 'at'])",
          "s": {
            ".validate": "newData.hasChildren(['endpoint', 'keys']) && newData.child('endpoint').isString() && newData.child('endpoint').val().beginsWith('https://') && newData.child('endpoint').val().length < 1000",
            "keys": { ".validate": "newData.hasChildren(['p256dh', 'auth'])" }
          },
          "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "push_keys": { ".read": false, ".write": false },

    // ⚠️ 2026-09-27 — «글이 이미 있으면 그 글쓴이만» 넣습니다. 전엔 숫자가 없는 글(운영자 글 등)에
    //    남이 숫자를 먼저 꽂을 수 있었습니다 → 그러면 «내 글 되찾기» 로 남의 글을 가져갈 수 있습니다.
    "qna_pins": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists() && ( !root.child('qna').child($id).exists() || root.child('qna').child($id).child('uid').val() === auth.uid )",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },

    // 🔑 «내 글 되찾기» 시도 칸 — 글마다 다섯 칸(0~4). 한 번 쓴 칸은 하루(24시간) 동안 다시 못 씁니다.
    //    그래서 «하루 다섯 번» 까지만 맞혀 볼 수 있습니다(4자리 = 1만 가지 → 하루 0.05%).
    //    칸에는 넣어 본 숫자의 해시만 둡니다. 아무도 못 읽습니다.
    "qna_try": {
      ".read": false,
      "$id": {
        "$n": {
          ".write": "auth != null && newData.exists() && $n.matches(/^[0-4]$/) && $id.length <= 40 && root.child('qna_pins').child($id).exists() && ( !data.exists() || data.child('at').val() < now - 86400000 )",
          ".validate": "newData.hasChildren(['h','u','at'])",
          "h":      { ".validate": "newData.isString() && newData.val().length === 64" },
          "u":      { ".validate": "newData.val() === auth.uid" },
          "at":     { ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 60000" },
          "$other": { ".validate": false }
        }
      }
    },

    // 🔑 이어 주기 — qna_who/{지금 번호} = { r: 옛 번호, q: 맞힌 글, n: 맞힌 칸 }
    //    «10분 안에, 내가 쓴 칸의 해시가 그 글의 4자리 해시와 같을 때» 만 들어갑니다.
    //    ⛔ 운영자 번호는 잇지도(r) 이어지지도($uid) 못합니다 — 표(op)·고정을 남이 가져가면 안 됩니다.
    "qna_who": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && $uid !== 'ZglL1g3X5UZFBA2590LirDnEnil1' && newData.exists()",
        ".validate": "newData.hasChildren(['r','q','n']) && root.child('qna_try').child(newData.child('q').val()).child(newData.child('n').val()).child('u').val() === auth.uid && root.child('qna_try').child(newData.child('q').val()).child(newData.child('n').val()).child('h').val() === root.child('qna_pins').child(newData.child('q').val()).val() && root.child('qna_try').child(newData.child('q').val()).child(newData.child('n').val()).child('at').val() > now - 600000 && newData.child('r').val() !== 'ZglL1g3X5UZFBA2590LirDnEnil1' && ( newData.child('r').val() === root.child('qna').child(newData.child('q').val()).child('uid').val() || newData.child('r').val() === root.child('qna_who').child(root.child('qna').child(newData.child('q').val()).child('uid').val()).child('r').val() )",
        "r":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "q":      { ".validate": "newData.isString() && newData.val().length <= 40" },
        "n":      { ".validate": "newData.isString() && newData.val().matches(/^[0-4]$/)" },
        "$other": { ".validate": false }
      }
    },

    // 🎁 2026-09-27 보상(명예) — 소장님 고르심 «명예만». 👍 도움됐어요 · 👑 이달의 답변왕 (Qna.jsx 8절 90)
    //    👍 는 «나» 한 번: 이어진 옛 번호(qna_who)가 있으면 그 번호로만, 없으면 지금 번호로만 — 기기 두 대로 두 번 못 누름.
    //    내 글(지금 번호·옛 번호)에는 못 누름. 빼기(null)는 누른 사람만.
    "qna_like": {
      ".read": true,
      "$id": {
        "$who": {
          ".write": "auth != null && ( ( root.child('qna_who').child(auth.uid).exists() && $who === root.child('qna_who').child(auth.uid).child('r').val() ) || ( !root.child('qna_who').child(auth.uid).exists() && $who === auth.uid ) ) && root.child('qna').child($id).exists() && root.child('qna').child($id).child('uid').val() !== auth.uid && root.child('qna').child($id).child('uid').val() !== root.child('qna_who').child(auth.uid).child('r').val()",
          ".validate": "newData.val() === true"
        }
      }
    },
    // 👁 2026-10-01 (G95) 조회수 — 소장님 「조회수 알 수 있지? 조회수도 넣어주고」
    //    글마다 숫자 하나(qna_v/{글번호}). **1씩만 올릴 수 있습니다** — 지우기 · 낮추기 · 아무 숫자 넣기는 막힘.
    //    사랑방은 이미 익명 로그인을 하므로 auth != null 로 충분합니다. 없는 글에는 못 붙입니다.
    //    ⚠️ 지우기는 .validate 를 안 거치므로 .write 에 newData.exists() 를 꼭 둡니다.
    //    같은 브라우저 하루 한 번 · 운영자 · 글쓴이 · 검색 로봇은 화면(Qna.jsx 조회세기)이 안 셉니다.
    "qna_v": {
      ".read": true,
      "$id": {
        ".write": "auth != null && newData.exists() && root.child('qna').child($id).exists()",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    // ⬇ 2026-10-01 (G96) 받은 횟수 — 소장님 「사이트 전체 … 다운받은 것은 다운로드 몇 번까지」
    //    dl/f/{파일} · dl/p/{화면} = 숫자 하나. **1씩만** 올릴 수 있습니다(지우기 · 낮추기 · 아무 숫자 막힘).
    //    파일을 받는 사람은 로그인을 안 하므로(익명 로그인도 안 부름 — 비용 원칙) auth 를 묻지 않습니다.
    //    대신 열쇠 꼴을 묶습니다: f 는 «|…,확장자» · p 는 «|한 마디» 또는 «|두|마디» (lib/받은수.jsx 열쇠꼴과 짝).
    //    ⚠️ 지우기는 .validate 를 안 거치므로 .write 에 newData.exists() 를 꼭 둡니다.
    "dl": {
      ".read": true,
      "f": {
        "$k": {
          ".write": "newData.exists() && $k.length <= 150 && $k.matches(/^[|].+,(xlsx|xlsm|xls|pdf|hwp|hwpx|docx|doc|zip|dwg|dxf|lsp|csv|pptx)$/i)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "p": {
        "$k": {
          ".write": "newData.exists() && $k.length <= 80 && $k.matches(/^[|][^|]*([|][^|]+)?$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "qna_alike": {
      ".read": true,
      "$qid": {
        "$aid": {
          "$who": {
            ".write": "auth != null && ( ( root.child('qna_who').child(auth.uid).exists() && $who === root.child('qna_who').child(auth.uid).child('r').val() ) || ( !root.child('qna_who').child(auth.uid).exists() && $who === auth.uid ) ) && root.child('qna_a').child($qid).child($aid).exists() && root.child('qna_a').child($qid).child($aid).child('uid').val() !== auth.uid && root.child('qna_a').child($qid).child($aid).child('uid').val() !== root.child('qna_who').child(auth.uid).child('r').val()",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    // 👑 이달의 답변왕 — 운영자 번호만 정하고 뺌. 키 = 상 받는 달(YYYY-MM)
    "qna_king": {
      ".read": true,
      "$ym": {
        ".write": "auth != null && auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1' && $ym.matches(/^[0-9]{4}-[0-9]{2}$/)",
        ".validate": "newData.hasChildren(['r','nick','at'])",
        "r":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "nick":   { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at":     { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "$other": { ".validate": false }
      }
    },

    // 📌 2026-09-27 — 사랑방 «도구 사용법» 고정. 소장님: 「도구설명서도 항상 위쪽에 배치 되도록 해주고」
    //    값 = 고정한 때(ms). 작은 것이 위. **운영자 브라우저만** 꽂고 뺍니다(OPS 와 같은 번호).
    //    ⚠️ 글(qna) 안에 칸을 늘리지 않았습니다 — $other:false 라 옛 규칙이면 글쓰기가 통째로 튕깁니다.
    "qna_top": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1'",
        ".validate": "$id.length <= 40 && newData.isNumber() && newData.val() <= (now + 60000)"
      }
    },

    // ⚡ 2026-09-30 — 공고 · 1순위 «빠른 길» (fast.py). 소장님: 「공고하고 1순위 좀 더 빨리 뜨게」
    //    10분마다 깃허브(fast.yml)가 오늘 새로 나온 공고 · 개찰을 여기 넣고, 화면(lib/fresh.js)이 목록 위에 얹습니다.
    //    누구나 읽고(공고는 조달청 공개 자료), 아무도 못 씁니다 — 서비스 계정은 규칙을 지나쳐 씁니다.
    //    묶음은 JSON 글자 한 덩이(rows/{first|live}/{i}) · 목록표(meta/{first|live}) = {at, built, n, p, h}
    "fresh": { ".read": true, ".write": false },

    // 🔔 2026-10-01 (G97) 다시 오게 — 소장님 「내 지역·면허를 한 번 정하면 … 관심 공고 결과가 나오면 알림을 보냅니다」
    //    watch/{공고번호}/{번호} = {at, t}         ☆ 담은 공고 — 1순위가 나오면 함수(freshNotify)가 한 번 알리고 지웁니다
    //    watch_cond/{번호}      = {rg, lic, none, at} 📍 내 조건 — 하루 두 번(8시 · 13시) 새 공고를 묶어 알림
    //    {번호} = 사랑방 · 폰 알림과 같은 번호(지금 uid 또는 되찾아 이어진 옛 번호 r). 주인만 넣고 빼며, 아무도 못 읽습니다(함수만 읽음).
    //    watch_last · watch_meta = 함수만 씀(지난번 보낸 때 · 보낸 칸 표시).
    "watch": {
      "$no": {
        "$r": {
          ".write": "auth != null && $no.length <= 30 && $no.matches(/^[A-Za-z0-9_-]+$/) && ( auth.uid === $r || root.child('qna_who').child(auth.uid).child('r').val() === $r )",
          ".validate": "!newData.exists() || newData.hasChildren(['at'])",
          "at":     { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "t":      { ".validate": "newData.isString() && newData.val().length <= 80" },
          "$other": { ".validate": false }
        }
      }
    },
    "watch_cond": {
      "$r": {
        ".write": "auth != null && ( auth.uid === $r || root.child('qna_who').child(auth.uid).child('r').val() === $r )",
        ".validate": "!newData.exists() || newData.hasChildren(['rg', 'at'])",
        "rg":     { ".validate": "newData.isString() && newData.val().length <= 12" },
        "lic":    { ".validate": "newData.isString() && newData.val().length <= 600" },
        "none":   { ".validate": "newData.isBoolean()" },
        "at":     { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "$other": { ".validate": false }
      }
    },
    "watch_last": { ".read": false, ".write": false },
    "watch_meta": { ".read": false, ".write": false },

    "qna_del": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('qna_pins').child($id).val()"
      }
    },

    // ───── 📋 내역서 작성 «문의함» (2026-09-15) ─────
    // 소장님: 「게시판이 없다. 만들 수 있어? 글만 작성하게 해서... 비용문제도 없지 않아?」
    //
    // 맞습니다. 그리고 여기는 구인구직과 **정반대**로 잠급니다.
    //   · 쓰기만 됩니다. 아무도 못 읽습니다(.read: false) — 문의에는 공사 정보와 연락처가 들어갑니다.
    //     남이 읽으면 경쟁사가 남의 공사를 들여다보는 꼴이 됩니다.
    //   · 한 번 쓰면 못 고치고 못 지웁니다(!data.exists()) — 장난으로 지우는 것을 막습니다.
    //   · 읽기가 막혀 있으니 «내려받기» 가 0 입니다. 요금이 붙을 일이 없습니다.
    //   · 소장님은 Firebase 콘솔(또는 관리자 키)로 보십니다.
    // 🔑 2026-09-18 — 소장님 «한 대만» 읽을 수 있게 열었습니다.
    //   소장님: 「내가 관리자인데 못봐...ㅎㅎㅎ」 — 맞는 말씀이었습니다.
    //   사이트에는 «관리자 로그인» 이 없어서 들어오는 사람이 모두 «이름 없는 방문자» 입니다.
    //   그래서 「아무도 못 읽음」 이 소장님까지 막고 있었습니다.
    //   → 브라우저 번호(uid) 가 아래 하나와 같을 때만 읽힙니다. 나머지는 그대로 전부 막힙니다.
    //   ⚠️ 이 번호는 «그 브라우저» 에 붙습니다. 기록을 지우거나 다른 PC 로 가면 바뀝니다.
    //      그때는 /admin 의 「이 브라우저 번호 베끼기」 로 새 번호를 받아 여기에 넣습니다.
    //   ⚠️ 쓰기는 «여전히» 한 번만 됩니다 — 고치지도 지우지도 못합니다.
    "quotes": {
      ".read": "auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1'",
      ".write": false,
      "$id": {
        // 🗑️ 2026-09-18 — 소장님: 「삭제하는 난이 없어」
        //   전에는 «만들기만» 되고 지우는 길이 아예 없었습니다.
        //   그래서 시험으로 넣은 글도 영영 남았습니다.
        //   → 운영자 브라우저는 «지우기» 만 됩니다. 고치기는 여전히 안 됩니다
        //     (!newData.exists() — 지우는 것 말고는 손을 못 댑니다).
        ".write": "!data.exists() || (auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1' && !newData.exists())",
        ".validate": "newData.hasChildren(['work', 'phone', 'at'])",
        "work":  { ".validate": "newData.isString() && newData.val().length <= 120" },
        "org":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "no":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "money": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "want":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "due":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "name":  { ".validate": "newData.isString() && newData.val().length <= 30" },
        "memo":  { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "at":    { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // 📝 문의에 단 답 — 2026-09-18
    //   소장님: 「답글 다는 형식으로 하자」
    //   ⚠️ 문의(quotes)는 «한 번 쓰면 못 고치는» 칸입니다. 거기에 답을 끼워 넣으면
    //      그 규칙을 흔들어야 합니다. 그래서 사랑방(qna_a)과 같이 **딴 칸**에 적습니다.
    //   ⚠️ 이건 «나에게 남기는 기록» 입니다. 문의하신 분에게 저절로 가지 않습니다 —
    //      그분께는 적어 주신 연락처로 답합니다. 여기는 「무엇을 어떻게 답했나」 를 남기는 자리입니다.
    "quote_a": {
      ".read": "auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1'",
      ".write": false,
      "$id": {
        ".write": "auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1'",
        ".validate": "newData.hasChildren(['b', 'at'])",
        "b":  { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ───── 새 사이트의 구인구직 ─────
    // 목록은 누구나 읽고, 글쓰기는 익명 로그인한 사람만.
    // 수정·숨김은 글쓴이 브라우저(uid)만 가능합니다.
    "jobs": {
      ".read": true,
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
        ".validate": "newData.hasChildren(['type','title','contact','uid','at'])",
        "type":    { ".validate": "newData.isString() && (newData.val() === '구인' || newData.val() === '구직')" },
        "title":   { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        // 회사·현장 (구직이면 경력·자격). 2026-09-14 추가 - 없으면 $other 규칙이 글 전체를 막습니다
        "co":      { ".validate": "newData.isString() && newData.val().length <= 40" },
        "trade":   { ".validate": "newData.isString() && newData.val().length <= 20" },
        "region":  { ".validate": "newData.isString() && newData.val().length <= 10" },
        "pay":     { ".validate": "newData.isString() && newData.val().length <= 30" },
        "contact": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 40" },
        "body":    { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "uid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "at":      { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "$other":  { ".validate": false }
      }
    },

    // 삭제용 비밀번호의 해시. 아무도 읽을 수 없고, 글 만들 때 한 번만 쓸 수 있습니다.
    "job_pins": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },

    // 삭제 요청. 제출한 해시가 job_pins 값과 같을 때만 서버가 받아줍니다.
    "job_del": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('job_pins').child($id).val()"
      }
    },

    // ───── 이용자가 올린 서식 (2026-09-06, 소장님: 승인 없이 바로 공개) ─────
    // 파일 본체는 Storage(user_forms/{uid}/…)에, 목록은 여기에. 읽기는 누구나(limitToLast 로 자릅니다).
    // url 은 반드시 우리 Storage 주소여야 합니다 — 남의 사이트 링크를 «서식» 인 척 올리는 걸 막습니다.
    "user_forms": {
      ".read": true,
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
        ".validate": "newData.hasChildren(['title','cat','uid','at','url','name','size','ext'])",
        "title": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "desc":  { ".validate": "newData.isString() && newData.val().length <= 300" },
        "cat":   { ".validate": "newData.isString() && newData.val().length <= 12" },
        "by":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "uid":   { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "at":    { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "url":   { ".validate": "newData.isString() && newData.val().beginsWith('https://firebasestorage.googleapis.com/v0/b/k-conmap.firebasestorage.app/o/user_forms%2F')" },
        "name":  { ".validate": "newData.isString() && newData.val().length <= 120" },
        "size":  { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 20971520" },
        "stored":{ ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10485760" },
        "ext":   { ".validate": "newData.isString() && newData.val().matches(/^(xlsx|xls|docx|doc|hwp|hwpx|pdf|pptx)$/)" },
        "gz":    { ".validate": "newData.isBoolean()" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "uf_pins": {
      ".read": false,
      "$id": { ".write": "auth != null && !data.exists()", ".validate": "newData.isString() && newData.val().length === 64" }
    },
    "uf_del": {
      ".read": true,
      "$id": { ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('uf_pins').child($id).val()" }
    },
    // 신고 — 한 사람(uid)당 한 번. 화면은 신고 3건 이상이면 목록에서 숨깁니다(승인 없이 공개하는 대신의 안전장치).
    "uf_flag": {
      ".read": true,
      "$id": {
        "$uid": { ".write": "auth != null && auth.uid === $uid && !data.exists()", ".validate": "newData.isBoolean()" }
      }
    },

    // ───── 공고·개찰 댓글 (2026-09-06, 소장님: 대화 창구) ─────
    // 공고번호 아래에 댓글. 카드를 펼쳤을 때만 get() 한 번(limitToLast 50). 실시간 구독 없음.
    "comments": {
      "$no": {
        ".read": true,
        ".indexOn": ["at"],
        "$id": {
          ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
          ".validate": "newData.hasChildren(['body','uid','at']) && $no.length <= 40",
          "body": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
          "by":   { ".validate": "newData.isString() && newData.val().length <= 20" },
          "uid":  { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "at":   { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },
    "comment_pins": {
      ".read": false,
      "$no": { "$id": { ".write": "auth != null && !data.exists()", ".validate": "newData.isString() && newData.val().length === 64" } }
    },
    "comment_del": {
      ".read": true,
      "$no": { "$id": { ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('comment_pins').child($no).child($id).val()" } }
    },

    // 📎 2026-09-27 업체 스스로 등록 — 소장님: 「장비, 자재, 기타 … 업자가 스스로 등록하게 … 세금계산서 발행 여부도 확인」 (TuipbiVin.jsx)
    //    cost_vlink/{현장}/{링크 20자} = 업체 링크(현장 사람만 만들고 끊음). 링크 «하나» 는 주소를 아는 사람(업체)이 읽음 — 목록은 못 읽음.
    //    cost_vin/{현장}/{링크}/{번호} = 업체가 적은 줄. 업체 = 끊기지 않은 링크 · 확인(ok) 전 줄만 쓰고 지움 · ok·taxok 는 못 씀 · 확인 뒤엔 tax 만.
    //    현장 사람 = 모두(✅ 확인 = cost_rows 한 줄 + ok 를 한 번에 update).
    "cost_vlink": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$link": {
          ".read": "data.exists()",
          ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
          ".validate": "$link.matches(/^[A-Za-z0-9]{20}$/) && newData.hasChildren(['k','n','sn','at'])",
          "k":   { ".validate": "newData.isString() && newData.val().matches(/^[EMO]$/)" },
          "ref": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "n":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "sn":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
          "off": { ".validate": "newData.isBoolean()" },
          "at":  { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "cost_vin": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$link": {
          ".read": "root.child('cost_vlink').child($site).child($link).exists()",
          "$id": {
            ".write": "auth != null && ( ( root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val() ) || ( root.child('cost_vlink').child($site).child($link).exists() && root.child('cost_vlink').child($site).child($link).child('off').val() !== true && ( !data.exists() || !data.child('ok').exists() ) && ( !newData.exists() || ( !newData.child('ok').exists() && !newData.child('taxok').exists() && !newData.child('okAt').exists() ) ) ) )",
            ".validate": "newData.hasChildren(['d','t','q','u','amt','at'])",
            "d":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "t":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "s":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "q":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
            "un":  { ".validate": "newData.isString() && newData.val().length <= 6" },
            "u":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000" },
            "amt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000" },
            "m":   { ".validate": "newData.isString() && newData.val().length <= 200" },
            // 🧾 세금계산서 — 현장이 확인한 뒤에도 업체가 «발행함» 만은 바꿀 수 있게(끊기지 않은 링크)
            "tax": {
              ".write": "auth != null && root.child('cost_vlink').child($site).child($link).exists() && root.child('cost_vlink').child($site).child($link).child('off').val() !== true && data.parent().exists()",
              ".validate": "newData.hasChildren(['y'])",
              "y":   { ".validate": "newData.isBoolean()" },
              "d":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
              "$other": { ".validate": false }
            },
            "ok":    { ".validate": "newData.isString() && newData.val().length <= 30" },
            "okAt":  { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
            "taxok": { ".validate": "newData.isBoolean()" },
            "by":    { ".validate": "newData.isString() && newData.val().length <= 64" },
            "at":    { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    // ───── 🏗 현장 투입비 (2026-09-26, 소장님: 「난 투입비만 나오면 돼 … 건설맵에서 등록해서 사용하게」) ─────
    // 현장 코드(9자리, 헷갈리는 글자 뺀 32가지 — 짐작으로 못 찾음) + 비밀번호(6자 이상).
    // 비밀번호는 해시만 cost_pins 에 둡니다(아무도 못 읽음, 한 번만 씀).
    // 이 브라우저(익명 uid)가 맞는 해시를 cost_keys/{현장}/{uid} 에 써야(틀리면 규칙이 거절) 그 현장을 읽고 씁니다.
    // 화면은 get() 만 씁니다(실시간 구독 없음).
    // 2026-09-26 더함 (소장님: 「노무자 및 장비, 자재 청구내역서 작성해서 보여주는 걸로 하자. 매달...」):
    //   명부(cost_people·cost_equip·cost_vendors) · 출역(cost_att) · 기성(cost_rows k='G').
    //   주민번호·계좌는 «x» 칸 하나에 브라우저에서 현장 비밀번호로 잠근 글(AES-GCM)로만 들어옵니다 — 서버는 못 읽음
    //   (개인정보 보호법 제24조의2 ② 암호화 보관). 그 밖의 칸은 $other 가 막습니다.
    "cost_pins": {
      ".read": false,
      "$site": {
        ".write": "auth != null && !data.exists() && $site.matches(/^[A-Z0-9]{9}$/)",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "cost_keys": {
      "$site": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.val() === root.child('cost_pins').child($site).val())"
        }
      }
    },
    "cost_sites": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".validate": "newData.hasChildren(['name','total','at'])",
        "name":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "total":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000000" },
        "budget": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000000" },
        "start":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "end":    { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "at":     { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "upd":    { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "co":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "del":    { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "$other": { ".validate": false }
      }
    },
    "cost_rows": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$row": {
          ".validate": "newData.hasChildren(['d','k','amt','at'])",
          "d":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "k":   { ".validate": "newData.isString() && newData.val().matches(/^[LMESXOG]$/)" },
          "t":   { ".validate": "newData.isString() && newData.val().length <= 100" },
          "amt": { ".validate": "newData.isNumber() && newData.val() >= -100000000000 && newData.val() <= 100000000000" },
          "q":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
          "u":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000" },
          "by":  { ".validate": "newData.isString() && newData.val().length <= 20" },
          "un":  { ".validate": "newData.isString() && newData.val().length <= 6" },
          "sp":  { ".validate": "newData.isString() && newData.val().length <= 40" },
          "eq":  { ".validate": "newData.isString() && newData.val().length <= 30" },
          "vd":  { ".validate": "newData.isString() && newData.val().length <= 30" },
          "at":  { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    // 📝 2026-09-28 공사일보 한 장 (TuipbiIlbo.jsx) — 날짜마다 한 덩이. 날씨·기온·공정률(%)·작업 내용(JSON 글)·특기사항·내일 계획
    "cost_day": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$d": {
          ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['at'])",
          "w":  { ".validate": "newData.isString() && newData.val().length <= 10" },
          "lo": { ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 60" },
          "hi": { ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 60" },
          "pp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "ap": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "wk": { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "nt": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "nx": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "cost_people": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$pid": {
          ".validate": "newData.hasChildren(['n','at'])",
          "n":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "j":   { ".validate": "newData.isString() && newData.val().length <= 20" },
          "w":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "tel": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "nx":  { ".validate": "newData.isString() && newData.val().matches(/^[PHET]{0,4}$/)" },
          "x":   { ".validate": "newData.isString() && newData.val().length <= 3000" },
          "off": { ".validate": "newData.isBoolean()" },
          "at":  { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "cost_equip": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$eid": {
          ".validate": "newData.hasChildren(['n','at'])",
          "n":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "s":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "v":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "u":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
          "un":  { ".validate": "newData.isString() && newData.val().length <= 6" },
          "x":   { ".validate": "newData.isString() && newData.val().length <= 3000" },
          "off": { ".validate": "newData.isBoolean()" },
          "at":  { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "cost_vendors": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$vid": {
          ".validate": "newData.hasChildren(['n','at'])",
          "n":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "g":   { ".validate": "newData.isString() && newData.val().length <= 60" },
          "x":   { ".validate": "newData.isString() && newData.val().length <= 3000" },
          "off": { ".validate": "newData.isBoolean()" },
          "at":  { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },
    "cost_att": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$ym": {
          ".validate": "$ym.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "$pid": {
            ".validate": "newData.hasChildren(['w'])",
            "w": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "d": { "$day": { ".validate": "$day.matches(/^(0[1-9]|[12][0-9]|3[01])$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= 3" } },
            "o": { "$k": { ".validate": "$k.matches(/^(it|lt|ei|np|hi|lc)$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" } },
            "m": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "ap": { ".validate": "newData.isString() && newData.val().matches(/^[PHE]{0,3}$/)" },
            "ex": { ".validate": "newData.isString() && newData.val().matches(/^[PHE]{0,3}$/)" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    // 🗑 2026-09-27 휴지통 (소장님: 「공사일보는 … 만약 지워져 버리면 큰일이야」)
    //   지운 줄·사람·장비·업체를 여기로 옮겨 30일 둡니다 → 화면의 «🗑 휴지통» 에서 되살림.
    //   30일 지난 것은 매일 백업(.github/workflows/공사일보백업.yml)이 백업을 뜬 «뒤에» 비웁니다.
    //   현장 지우기는 cost_sites/{현장}/del 에 지운 때만 찍습니다(자료는 그대로 30일).
    //   p = 원래 자리(rows·people·equip·vendors) · k = 원래 번호 · v = 원래 내용 · at = 지운 때
    "cost_trash": {
      "$site": {
        ".read": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        ".write": "auth != null && root.child('cost_pins').child($site).exists() && root.child('cost_keys').child($site).child(auth.uid).val() === root.child('cost_pins').child($site).val()",
        "$t": {
          ".validate": "newData.hasChildren(['p','k','v','at'])",
          "p":  { ".validate": "newData.isString() && newData.val().matches(/^(rows|people|equip|vendors)$/)" },
          "k":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "v":  { ".validate": "newData.hasChildren()" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "$other": { ".validate": false }
        }
      }
    },

    // ───── 🚜 장비 임대료·수금 장부 (2026-09-29, pages/EquipBook.jsx · lib/장부.js ns 'eq') ─────
    // 소장님: 「(서식의 장비관리 엑셀) 좀 이상해 … 되도록 사이트내에서 사용 할 수 있는 프로그램으로 만들어 줘」
    // 현장 투입비(cost_*)와 같은 문: 장부 코드 9자리 + 비밀번호 해시(eq_pins, 아무도 못 읽음) + 이 브라우저가 맞힌 해시(eq_keys).
    // 사업자번호·계좌는 eq_books/*/x 한 칸에 브라우저에서 잠근 글(AES-GCM)로만 — 서버는 못 읽음.
    // 매일 백업·휴지통 비우기: tools/공사일보백업.py (묶음들)
    "eq_pins": {
      ".read": false,
      "$c": {
        ".write": "auth != null && !data.exists() && $c.matches(/^[A-Z0-9]{9}$/)",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "eq_keys": {
      "$c": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.val() === root.child('eq_pins').child($c).val())"
        }
      }
    },
    "eq_books": {
      "$c": {
        ".read": "auth != null && root.child('eq_pins').child($c).exists() && root.child('eq_keys').child($c).child(auth.uid).val() === root.child('eq_pins').child($c).val()",
        ".write": "auth != null && root.child('eq_pins').child($c).exists() && root.child('eq_keys').child($c).child(auth.uid).val() === root.child('eq_pins').child($c).val()",
        ".validate": "newData.hasChildren(['name','at'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "ceo": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "tel": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "addr": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "x": { ".validate": "newData.isString() && newData.val().length <= 3000" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "upd": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "del": { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "$other": { ".validate": false }
      }
    },
    "eq_drivers": {
      "$c": {
        ".read": "auth != null && root.child('eq_pins').child($c).exists() && root.child('eq_keys').child($c).child(auth.uid).val() === root.child('eq_pins').child($c).val()",
        ".write": "auth != null && root.child('eq_pins').child($c).exists() && root.child('eq_keys').child($c).child(auth.uid).val() === root.child('eq_pins').child($c).val()",
        "$id": {
          ".validate": "newData.hasChildren(['n','e','at'])",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
