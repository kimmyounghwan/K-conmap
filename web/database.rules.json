// K-건설맵 RTDB 규칙
//
// ⚠️ 이 파일은 기존 Streamlit(k-conmap) 규칙에 구인구직을 더한 "병합본"입니다.
//    stats / sarasa / archive_* / service_* 를 지우면 돌아가는 사이트가 깨집니다.
//
// ⚠️ 루트를 "auth != null" 로만 두면, 익명 로그인을 켜는 순간
//    누구나 DB 전체를 읽고 쓸 수 있게 됩니다. 익명은 반드시 제외합니다.
//
// 원래 규칙 백업: _임시/rtdb_rules_백업_20260830.json

{
  "rules": {
    ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
    ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",

    // ───── 기존 Streamlit 이 쓰는 노드 (건드리지 말 것) ─────
    "stats": { ".read": true, ".write": true },
    "sarasa": { ".read": true, ".write": true },
    "archive_1st": { ".indexOn": ["날짜"] },
    "archive_live": { ".indexOn": ["공고일자"] },
    "service_1st": { ".indexOn": ["날짜"] },
    "service_live": { ".indexOn": ["공고일자"] },

    // ───── 💬 묻고 답하기 (2026-09-15) ─────
    // 소장님: 「건설맵 이용자가 이용할 수 있는 게시판도 있어야 하지 않아」 · 「묻고 답하기 형식으로」
    //
    // 구인구직과 같은 얼개입니다 — 누구나 읽고, 익명 로그인한 사람만 쓰고,
    // 지우는 건 글쓴이 브라우저(uid)만. 삭제 비밀번호는 해시로만 둡니다.
    //
    // ⚠️ 연락처 칸이 «없습니다». 공개 게시판에 전화번호를 적으면 광고 전화가 갑니다.
    //    연락처가 필요한 이야기는 내역서 문의함(quotes)으로 갑니다.
    "qna": {
      ".read": true,
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
        ".validate": "newData.hasChildren(['t','nick','uid','at'])",
        "t":       { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
        "b":       { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "nick":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "uid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "at":      { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "$other":  { ".validate": false }
      }
    },

    // 답변. **누구나 답니다** — 가입도 로그인도 없습니다. 그건 그대로입니다.
    //
    // 🚨 2026-09-17 — 「K-건설맵 답변」 표(op)가 **아무나 달 수 있게 열려 있었습니다.**
    //    전에는 «op 가 참/거짓이기만 하면» 통과였습니다. 화면에서 열쇠말을 맞춰 보긴 했지만
    //    그 비교는 **브라우저 «안에서만»** 했습니다 — 개발자도구를 아는 사람은 그냥 표를 답니다.
    //    그 표를 달고 틀린 답이 올라가면 이용자는 «현장소장이 답했다» 고 읽습니다.
    //
    // → 이제 **서버(이 규칙)가 uid 를 봅니다.** 운영자 브라우저가 아니면 op 를 참으로 못 넣습니다.
    //   소장님: 「답글에 비번이 왜 필요해.. 유료만 필요하지」 — 맞는 말씀이라 **열쇠말을 없앴습니다.**
    //
    // ⚠️ uid 를 여기 적어도 안전합니다. 익명 로그인은 «원하는 uid 로» 로그인할 수 없습니다 —
    //    uid 를 안다고 그 사람이 될 수 없습니다. (파이어베이스에서 흔히 쓰는 방식입니다)
    // ⚠️ 브라우저 기록을 지우면 uid 가 바뀝니다. 그러면 여기에 새 번호를 «더하고» 다시 올리면 됩니다.
    //    기기를 바꾸실 때도 마찬가지입니다 — 사랑방 「이 사랑방 쓰는 법」 맨 아래에
    //    그 브라우저의 번호가 적혀 있습니다.
    // ⚠️ 화면(Qna.jsx)의 OPS 목록과 **반드시 같아야** 합니다. 한쪽만 고치면
    //    화면은 표를 붙이려 하는데 서버가 막아 «올리지 못했습니다» 가 납니다.
    "qna_a": {
      ".read": true,
      "$qid": {
        "$aid": {
          ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
          ".validate": "newData.hasChildren(['b','nick','uid','at'])",
          "b":       { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 2000" },
          "nick":    { ".validate": "newData.isString() && newData.val().length <= 20" },
          // ⛔ 운영자 브라우저만 참으로 넣을 수 있습니다. 나머지는 거짓이거나 아예 없어야 합니다.
          //    ⚠️ 번호를 «여기 규칙 안에» 적습니다. DB 에 명단을 따로 두면 그 명단을 넣을 길이
          //       없습니다(3_규칙올리기.bat 은 규칙만 올립니다). 기기를 더하실 땐 || 로 이어 붙이고
          //       그 배치파일을 한 번 돌리면 끝입니다.
          "op":      { ".validate": "newData.isBoolean() && ( newData.val() === false || auth.uid === 'ZglL1g3X5UZFBA2590LirDnEnil1' )" },
          "uid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
          "at":      { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "$other":  { ".validate": false }
        }
      }
    },

    // 💬 «이 글은 메일로 알렸다» 표시. 기계(tools/qna_mail.py)만 씁니다 —
    //    서비스 계정은 규칙을 지나쳐 쓰므로 여기는 둘 다 막아 둡니다.
    //    ⚠️ 표시를 글(qna) «안에» 두지 않습니다 — $other: .validate false 와 부딪히고,
    //       이용자 글을 기계가 고치는 것도 맞지 않습니다.
    "qna_mail": { ".read": false, ".write": false },

    "qna_pins": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },

    "qna_del": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('qna_pins').child($id).val()"
      }
    },

    // ───── 📋 내역서 작성 «문의함» (2026-09-15) ─────
    // 소장님: 「게시판이 없다. 만들 수 있어? 글만 작성하게 해서... 비용문제도 없지 않아?」
    //
    // 맞습니다. 그리고 여기는 구인구직과 **정반대**로 잠급니다.
    //   · 쓰기만 됩니다. 아무도 못 읽습니다(.read: false) — 문의에는 공사 정보와 연락처가 들어갑니다.
    //     남이 읽으면 경쟁사가 남의 공사를 들여다보는 꼴이 됩니다.
    //   · 한 번 쓰면 못 고치고 못 지웁니다(!data.exists()) — 장난으로 지우는 것을 막습니다.
    //   · 읽기가 막혀 있으니 «내려받기» 가 0 입니다. 요금이 붙을 일이 없습니다.
    //   · 소장님은 Firebase 콘솔(또는 관리자 키)로 보십니다.
    "quotes": {
      ".read": false,
      ".write": false,
      "$id": {
        ".read": false,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['work', 'phone', 'at'])",
        "work":  { ".validate": "newData.isString() && newData.val().length <= 120" },
        "org":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "no":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "money": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "want":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "due":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "name":  { ".validate": "newData.isString() && newData.val().length <= 30" },
        "memo":  { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "at":    { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // ───── 새 사이트의 구인구직 ─────
    // 목록은 누구나 읽고, 글쓰기는 익명 로그인한 사람만.
    // 수정·숨김은 글쓴이 브라우저(uid)만 가능합니다.
    "jobs": {
      ".read": true,
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
        ".validate": "newData.hasChildren(['type','title','contact','uid','at'])",
        "type":    { ".validate": "newData.isString() && (newData.val() === '구인' || newData.val() === '구직')" },
        "title":   { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        // 회사·현장 (구직이면 경력·자격). 2026-09-14 추가 - 없으면 $other 규칙이 글 전체를 막습니다
        "co":      { ".validate": "newData.isString() && newData.val().length <= 40" },
        "trade":   { ".validate": "newData.isString() && newData.val().length <= 20" },
        "region":  { ".validate": "newData.isString() && newData.val().length <= 10" },
        "pay":     { ".validate": "newData.isString() && newData.val().length <= 30" },
        "contact": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 40" },
        "body":    { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "uid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "at":      { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "$other":  { ".validate": false }
      }
    },

    // 삭제용 비밀번호의 해시. 아무도 읽을 수 없고, 글 만들 때 한 번만 쓸 수 있습니다.
    "job_pins": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },

    // 삭제 요청. 제출한 해시가 job_pins 값과 같을 때만 서버가 받아줍니다.
    "job_del": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('job_pins').child($id).val()"
      }
    },

    // ───── 이용자가 올린 서식 (2026-09-06, 소장님: 승인 없이 바로 공개) ─────
    // 파일 본체는 Storage(user_forms/{uid}/…)에, 목록은 여기에. 읽기는 누구나(limitToLast 로 자릅니다).
    // url 은 반드시 우리 Storage 주소여야 합니다 — 남의 사이트 링크를 «서식» 인 척 올리는 걸 막습니다.
    "user_forms": {
      ".read": true,
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
        ".validate": "newData.hasChildren(['title','cat','uid','at','url','name','size','ext'])",
        "title": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "desc":  { ".validate": "newData.isString() && newData.val().length <= 300" },
        "cat":   { ".validate": "newData.isString() && newData.val().length <= 12" },
        "by":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "uid":   { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "at":    { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
        "url":   { ".validate": "newData.isString() && newData.val().beginsWith('https://firebasestorage.googleapis.com/v0/b/k-conmap.firebasestorage.app/o/user_forms%2F')" },
        "name":  { ".validate": "newData.isString() && newData.val().length <= 120" },
        "size":  { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 20971520" },
        "stored":{ ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10485760" },
        "ext":   { ".validate": "newData.isString() && newData.val().matches(/^(xlsx|xls|docx|doc|hwp|hwpx|pdf|pptx)$/)" },
        "gz":    { ".validate": "newData.isBoolean()" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "uf_pins": {
      ".read": false,
      "$id": { ".write": "auth != null && !data.exists()", ".validate": "newData.isString() && newData.val().length === 64" }
    },
    "uf_del": {
      ".read": true,
      "$id": { ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('uf_pins').child($id).val()" }
    },
    // 신고 — 한 사람(uid)당 한 번. 화면은 신고 3건 이상이면 목록에서 숨깁니다(승인 없이 공개하는 대신의 안전장치).
    "uf_flag": {
      ".read": true,
      "$id": {
        "$uid": { ".write": "auth != null && auth.uid === $uid && !data.exists()", ".validate": "newData.isBoolean()" }
      }
    },

    // ───── 공고·개찰 댓글 (2026-09-06, 소장님: 대화 창구) ─────
    // 공고번호 아래에 댓글. 카드를 펼쳤을 때만 get() 한 번(limitToLast 50). 실시간 구독 없음.
    "comments": {
      "$no": {
        ".read": true,
        ".indexOn": ["at"],
        "$id": {
          ".write": "auth != null && newData.exists() && ( !data.exists() || data.child('uid').val() === auth.uid )",
          ".validate": "newData.hasChildren(['body','uid','at']) && $no.length <= 40",
          "body": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
          "by":   { ".validate": "newData.isString() && newData.val().length <= 20" },
          "uid":  { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "at":   { ".validate": "newData.isNumber() && newData.val() <= (now + 60000)" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },
    "comment_pins": {
      ".read": false,
      "$no": { "$id": { ".write": "auth != null && !data.exists()", ".validate": "newData.isString() && newData.val().length === 64" } }
    },
    "comment_del": {
      ".read": true,
      "$no": { "$id": { ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('comment_pins').child($no).child($id).val()" } }
    }
  }
}
