{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(xml|txt|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "/data/first.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/data/live.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/data/overview.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/data/bidindex.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=86400"
          }
        ]
      },
    {
        "source": "/data/aparts.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/data/naeyeok.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/data/naeyeok-all.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/data/board/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=1800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/naeyeok/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600, must-revalidate"
          }
        ]
      },
      {
        "//": "서비스 워커는 절대 캐시하지 않는다 — 캐시되면 새 sw.js 가 영영 안 내려간다 (2026-09-06, 앱 설치용)",
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
