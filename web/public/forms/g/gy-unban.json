"대표자"],[49,15,1,7,8,0,"주소"],[49,22,1,3,8,0,"연락처"],[50,1,1,2,9,1,"갑"],[50,3,1,5,9,1],[50,8,1,4,9,1],[50,12,1,3,9,1],[50,15,1,7,10,1],[50,22,1,3,9,1],[51,1,1,2,9,1,"을"],[51,3,1,5,9,1],[51,8,1,4,9,1],[51,12,1,3,9,1],[51,15,1,7,10,1],[51,22,1,3,9,1],[53,1,1,24,5,0,"※ 이 계약서는 일반 양식입니다. 실제 체결 전에 반드시 검토를 받으시고, 정부가 고시한 표준계약서가 있는 계약은 그 원문을 사용하시는 편이 안전합니다."],[56,1,1,24,5,1,"          년        월        일",null,"yyyy\"년\" m\"월\" d\"일\""],[57,1,1,10,11,0,""],[57,11,1,6,12,0,"갑 (위탁자)"],[57,17,1,4,5,1],[57,21,1,4,13,0,"(서명 또는 인)"],[58,1,1,10,11,0,""],[58,11,1,6,12,0,"을 (운반자)"],[58,17,1,4,5,1],[58,21,1,4,13,0,"(서명 또는 인)"]],"img":[],"notes":["노란 칸 = 요율·기준값(발주기관 기준으로 고쳐 씀) · 옅은 하늘색 칸 = 자동 계산(지우지 마세요) · 뒤 시트에 «작성 예시» 가 있습니다.","발주기관이 정한 서식이 있으면 그 서식을 쓰세요. 이 줄과 1행은 지워도 됩니다."],"brk":[],"keys":{"G5":"공사명","G6":"운반품목","G7":"상차장소","G8":"하차장소","G9":"운반거리","G10":"단가기준","G11":"단가","G12":"운반기간","G13":"대기료","G14":"대금지급기한","A50":"구분#1","C50":"상호#1","H50":"등록#1","L50":"대표#1","O50":"주소#1","V50":"연락#1","A51":"구분#2","C51":"상호#2","H51":"등록#2","L51":"대표#2","O51":"주소#2","V51":"연락#2","A50:A51":"구분[]","C50:C51":"상호[]","H50:H51":"등록[]","L50:L51":"대표[]","O50:O51":"주소[]","V50:V51":"연락[]","A56":"서명일","Q57":"서명:갑(위탁자)","Q58":"서명:을(운반자)"}}],"st":[{"b":1,"k":"0F203F","a":"left"},{"z":8.5,"k":"6B7280","a":"right"},{"z":19.0,"b":1,"k":"111827","a":"center","w":1},{"b":1,"g":"F3F5F9","a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"center","w":1},{"z":10.5,"b":1,"a":"left","w":1},{"a":"left","v":"top","w":1},{"b":1,"g":"E8EEF7","a":"center","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"center","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"z":9.0,"a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"left","w":1},{"b":1,"a":"right","w":1},{"z":8.5,"a":"center","w":1}],"ex":{"0!G5":"가나지구 배수로 정비공사","0!G6":"사토(터파기 잔토)","0!G7":"STA.0+420 현장","0!G8":"가나시 사토장(허가 제0000호)","0!G9"