{"v":1,"slug":"gy-imdae","title":"건설기계 임대차계약서","sheets":[{"name":"건설기계 임대차계약서","exn":"작성 예시","w":[18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75],"h":[20.0,6.0,38.0,10.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,6.0,34.0,6.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,29.0,4.0,20.0,43.5,4.0,7.571428571428571,7.571428571428571,7.571428571428571,7.571428571428571,7.571428571428571,7.571428571428571,7.571428571428571,20.0,58.0,4.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,43.5,4.0,6.0,24.0,22.0,22.0,6.0,34.0,6.0,10.0,26.0,24.0,24.0,6.0,15.0,34.0,19.5],"pc":24,"pr":68,"land":0,"fit":0,"marg":[0.3,0.3,0.4,0.4],"cells":[[1,1,1,12,0,0,"  K-건설맵  |  k-conmap.com  건설 서식"],[1,13,1,12,1,0,""],[3,1,1,24,2,0,"건설기계 임대차계약서"],[5,1,1,6,3,0,"  공 사 명"],[5,7,1,18,4,1],[6,1,1,6,3,0,"  현장 위치"],[6,7,1,18,4,1],[7,1,1,6,3,0,"  장비명 / 규격"],[7,7,1,18,4,1],[8,1,1,6,3,0,"  등록번호"],[8,7,1,18,4,1],[9,1,1,6,3,0,"  임대 기간"],[9,7,1,18,4,1],[10,1,1,6,3,0,"  임대료(단가)"],[10,7,1,18,4,1],[11,1,1,6,3,0,"  1일 기준시간"],[11,7,1,18,4,1],[12,1,1,6,3,0,"  대기료"],[12,7,1,18,4,1],[13,1,1,6,3,0,"  유류 부담"],[13,7,1,18,4,1],[14,1,1,6,3,0,"  운반비 부담"],[14,7,1,18,4,1],[15,1,1,6,3,0,"  조종사"],[15,7,1,18,4,1],[16,1,1,6,3,0,"  대금 지급기한"],[16,7,1,18,4,1],[18,1,1,24,5,0,"임차인(이하 「갑」)과 임대인(이하 「을」)은 위 건설기계의 임대차에 관하여 다음과 같이 계약을 체결한다."],[20,1,1,24,6,0,"제1조 (목적)"],[21,1,1,24,7,0,"을은 위 건설기계를 갑에게 임대하고, 갑은 이를 위 현장에서 사용하며 그 대가를 지급한다."],[23,1,1,24,6,0,"제2조 (임대료와 지급)"],[24,1,1,24,7,0,"임대료는 위에 적은 단가에 따라 산정하며, 갑은 위 지급기한 안에 을에게 지급한다."],[26,1,1,24,6,0,"제3조 (작업시간과 대기)"],[27,1,1,24,7,0,"1일 기준시간은 위와 같으며, 이를 넘는 작업은 별도로 정산한다. 갑의 사정으로 장비가 대기한 때에는 위 대기료를 지급한다."],[29,1,1,24,6,0,"제4조 (유류·운반·조종사)"],[30,1,1,24,7,0,"유류비·운반비·조종사 인건비의 부담은 위 표에 따른다."],[32,1,1,24,6,0,"제5조 (반입과 반출)"],[33,1,1,24,7,0,"반입일과 반출일은 반입·반출 확인서로 확인하며, 그 기간을 임대 기간으로 본다."],[42,1,1,24,6,0,"제6조 (안전과 보험)"],[43,1,1,24,7,0,"을은 건설기계와 조종사에 대한 법정 보험에 가입한다. 조종사는 유효한 면허를 보유하여야 하며, 갑은 현장 안전수칙을 알리고 을은 이를 지킨다."],[45,1,1,24,6,0,"제7조 (고장과 정비)"],[46,1,1,24,7,0,"장비의 고장·정비로 작업하지 못한 시간은 임대료 산정에서 제외한다. 을은 지체 없이 대체 장비를 투입하도록 노력한다."],[48,1,1,24,6,0,"제8조 (손해)"],[49,1,1,24,7,0,"갑의 귀책으로 장비가 손상된 때에는 갑이, 을의 귀책으로 공사에 손해가 생긴 때에는 을이 배상한다."],[51,1,1,24,6,0,"제9조 (계약의 해지)"],[52,1,1,24,7,0,"상대방이 이 계약을 위반하고 서면 최고에도 시정하지 아니한 때에는 계약을 해지할 수 있다."],[54,1,1,24,6,0,"제10조 (분쟁의 해결)"],[55,1,1,24,7,0,"분쟁은 협의로 해결하되, 협의가 되지 아니한 때에는 관할 법원의 판결에 따른다."],[58,1,1,2,8,0,"구분"],[58,3,1,5,8,0,"상호(성명)"],[58,8,1,4,8,0,"사업자등록번호"],[58,12,1,3,8,0,"대표자"],[58,15,1,7,8,0,"주소"],[58,22,1,3,8,0,"연락처"],[59,1,1,2,9,1,"갑"],[59,3,1,5,9,1],[59,8,1,4,9,1],[59,12,1,3,9,1],[59,15,1,7,10,1],[59,22,1,3,9,1],[60,1,1,2,9,1,"을"],[60,3,1,5,9,1],[60,8,1,4,9,1],[60,12,1,3,9,1],[60,15,1,7,10,1],[60,22,1,3,9,1],[62,1,1,24,5,0,"※ 이 계약서는 일반 양식입니다. 실제 체결 전에 반드시 검토를 받으시고, 정부가 고시한 표준계약서가 있는 계약은 그 원문을 사용하시는 편이 안전합니다."],[65,1,1,24,5,1,"          년        월        일",null,"yyyy\"년\" m\"월\" d\"일\""],[66,1,1,10,11,0,""],[66,11,1,6,12,0,"갑 (임차인)"],[66,17,1,4,5,1],[66,21,1,4,13,0,"(서명 또는 인)"],[67,1,1,10,11,0,""],[67,11,1,6,12,0,"을 (임대인)"],[67,17,1,4,5,1],[67,21,1,4,13,0,"(서명 또는 인)"]],"img":[],"notes":["노란 칸 = 요율·기준값(발주기관 기준으로 고쳐 씀) · 옅은 하늘색 칸 = 자동 계산(지우지 마세요) · 뒤 시트에 «작성 예시» 가 있습니다.","발주기관이 정한 서식이 있으면 그 서식을 쓰세요. 이 줄과 1행은 지워도 됩니다."],"brk":[],"keys":{"G5":"공사명","G6":"현장위치","G7":"장비명/규격","G8":"등록번호","G9":"임대기간","G10":"임대료(단가)","G11":"1일기준시간","G12":"대기료","G13":"유류부담","G14":"운반비부담","G15":"조종사","G16":"대금지급기한","A59":"구분#1","C59":"상호#1","H59":"등록#1","L59":"대표#1","O59":"주소#1","V59":"연락#1","A60":"구분#2","C60":"상호#2","H60":"등록#2","L60":"대표#2","O60":"주소#2","V60":"연락#2","A59:A60":"구분[]","C59:C60":"상호[]","H59:H60":"등록[]","L59:L60":"대표[]","O59:O60":"주소[]","V59:V60":"연락[]","A65":"서명일","Q66":"서명:갑(임차인)","Q67":"서명:을(임대인)"}}],"st":[{"b":1,"k":"0F203F","a":"left"},{"z":8.5,"k":"6B7280","a":"right"},{"z":19.0,"b":1,"k":"111827","a":"center","w":1},{"b":1,"g":"F3F5F9","a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"left","w":1,