{"v":1,"slug":"gy-yongyeok","title":"용역계약서","sheets":[{"name":"용역계약서","exn":"작성 예시","w":[18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75],"h":[20.0,6.0,38.0,10.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,6.0,34.0,6.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,29.0,4.0,20.0,58.0,4.0,20.0,43.5,4.0,20.0,29.0,4.0,7.6,7.6,7.6,7.6,7.6,20.0,43.5,4.0,20.0,43.5,4.0,6.0,24.0,22.0,22.0,6.0,34.0,6.0,10.0,26.0,24.0,24.0,6.0,15.0,34.0,19.5],"pc":24,"pr":58,"land":0,"fit":0,"marg":[0.3,0.3,0.4,0.4],"cells":[[1,1,1,12,0,0,"  K-건설맵  |  k-conmap.com  무료 건설 서식"],[1,13,1,12,1,0,""],[3,1,1,24,2,0,"용  역  계  약  서"],[5,1,1,6,3,0,"  용 역 명"],[5,7,1,18,4,1],[6,1,1,6,3,0,"  용역 기간"],[6,7,1,18,4,1],[7,1,1,6,3,0,"  용역 금액"],[7,7,1,18,5,1,null,null,"\"₩\"#,##0\" (부가세 포함)\";;\"\""],[8,1,1,6,3,0,"  부가가치세"],[8,7,1,18,6,2,null,"IF(N(G7)=0,\"\",G7-ROUND(G7/1.1,0))","#,##0\"원 (계약금액에 포함)\";;\"\""],[9,1,1,6,3,0,"  성과품 제출 기한"],[9,7,1,18,7,1,null,null,"yyyy\"년\" m\"월\" d\"일\""],[10,1,1,6,3,0,"  대금 지급방법"],[10,7,1,18,4,1],[11,1,1,6,3,0,"  무상 보완 횟수"],[11,7,1,18,4,1],[13,1,1,24,8,0,"발주자(이하 「갑」)와 수행자(이하 「을」)는 위 용역에 관하여 다음과 같이 계약을 체결한다."],[15,1,1,24,9,0,"제1조 (목적과 범위)"],[16,1,1,24,10,0,"을은 별첨 과업지시서에 따라 용역을 수행하고 성과품을 제출하며, 갑은 그 대가를 지급한다."],[18,1,1,24,9,0,"제2조 (성과품)"],[19,1,1,24,10,0,"성과품의 종류·수량·형식은 별첨 목록에 따른다. 을은 제출 기한까지 성과품을 제출한다."],[21,1,1,24,9,0,"제3조 (검수와 보완)"],[22,1,1,24,10,0,"갑은 성과품을 검수하고 보완이 필요한 사항을 서면으로 통지한다. 을은 위 횟수의 범위에서 무상으로 보완한다."],[24,1,1,24,9,0,"제4조 (대금의 지급)"],[25,1,1,24,10,0,"갑은 검수에 합격한 후 위 지급방법에 따라 대가를 지급한다."],[27,1,1,24,9,0,"제5조 (성과품의 권리)"],[28,1,1,24,10,0,"성과품의 소유권은 대가 지급과 동시에 갑에게 이전한다. 저작인격권은 을에게 유보되며, 갑은 이 용역의 목적 범위에서 성과품을 사용할 수 있다."],[30,1,1,24,9,0,"제6조 (기술자의 배치)"],[31,1,1,24,10,0,"을은 관계 법령에서 정한 자격을 갖춘 기술자를 배치하고, 갑의 동의 없이 임의로 교체하지 아니한다."],[33,1,1,24,9,0,"제7조 (비밀 유지)"],[34,1,1,24,10,0,"을은 용역 수행 중 알게 된 갑의 정보를 제3자에게 누설하지 아니한다."],[41,1,1,24,9,0,"제8조 (지체와 해지)"],[42,1,1,24,10,0,"을의 책임으로 성과품 제출이 늦어진 때에는 지체상금을 지급한다. 계약 위반이 시정되지 아니한 때에는 계약을 해지할 수 있다."],[44,1,1,24,9,0,"제9조 (분쟁의 해결)"],[45,1,1,24,10,0,"분쟁은 협의로 해결하되, 협의가 되지 아니한 때에는 관할 법원의 판결에 따른다."],[48,1,1,2,11,0,"구분"],[48,3,1,5,11,0,"상호(성명)"],[48,8,1,4,11,0,"사업자등록번호"],[48,12,1,3,11,0,"대표자"],[48,15,1,7,11,0,"주소"],[48,22,1,3,11,0,"연락처"],[49,1,1,2,7,1,"갑"],[49,3,1,5,7,1],[49,8,1,4,7,1],[49,12,1,3,7,1],[49,15,1,7,12,1],[49,22,1,3,7,1],[50,1,1,2,7,1,"을"],[50,3,1,5,7,1],[50,8,1,4,7,1],[50,12,1,3,7,1],[50,15,1,7,12,1],[50,22,1,3,7,1],[52,1,1,24,8,0,"※ 이 계약서는 일반 양식입니다. 실제 체결 전에 반드시 검토를 받으시고, 정부가 고시한 표준계약서가 있는 계약은 그 원문을 사용하시는 편이 안전합니다."],[55,1,1,24,8,1,"          년        월        일",null,"yyyy\"년\" m\"월\" d\"일\""],[56,1,1,10,13,0,""],[56,11,1,6,14,0,"갑 (발주자)"],[56,17,1,4,8,1],[56,21,1,4,15,0,"(서명 또는 인)"],[57,1,1,10,13,0,""],[57,11,1,6,14,0,"을 (수행자)"],[57,17,1,4,8,1],[57,21,1,4,15,0,"(서명 또는 인)"]],"img":[],"notes":["노란 칸 = 요율·기준값(발주기관 기준으로 고쳐 씀) · 옅은 하늘색 칸 = 자동 계산(지우지 마세요) · 뒤 시트에 «작성 예시» 가 있습니다.","발주기관이 정한 서식이 있으면 그 서식을 쓰세요. 이 줄과 1행은 지워도 됩니다."],"brk":[],"keys":{"G5":"용역명","G6":"용역기간","G7":"용역금액","G8":"부가가치세","G9":"성과품제출기한","G10":"대금지급방법","G11":"무상보완횟수","A49":"구분#1","C49":"상호#1","H49":"등록#1","L49":"대표#1","O49":"주소#1","V49":"연락#1","A50":"구분#2","C50":"상호#2","H50":"등록#2","L50":"대표#2","O50":"주소#2","V50":"연락#2","A49:A50":"구분[]","C49:C50":"상호[]","H49:H50":"등록[]","L49:L50":"대표[]","O49:O50":"주소[]","V49:V50":"연락[]","A55":"서명일","Q56":"서명:갑(발주자)","Q57":"서명:을(수행자)"}}],"st":[{"b":1,"k":"0F203F","a":"left"},{"z":8.5,"k":"6B7280","a":"right"},{"z":19.0,"b":1,"k":"111827","a":"center","w":1},{"b":1,"g":"F3F5F9","a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"right","s":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"g":"EEF4FC","a":"right","s":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"center","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"center","w":1},{"z":10.5,"b":1,"a":"left","w":1},{"a":"left","v":"top","w":1}