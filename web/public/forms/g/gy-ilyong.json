요한 안전조치와 교육을 한다."],[48,1,1,24,7,0,"제7조 (계약서의 교부)"],[49,1,1,24,8,0,"갑은 이 계약서를 2통 작성하여 1통을 을에게 준다."],[51,1,1,24,7,0,"제8조 (그 밖의 사항)"],[52,1,1,24,8,0,"이 계약에 정하지 아니한 사항은 근로기준법 등 관계 법령에 따른다."],[55,1,1,2,9,0,"구분"],[55,3,1,5,9,0,"상호(성명)"],[55,8,1,4,9,0,"사업자등록번호"],[55,12,1,3,9,0,"대표자"],[55,15,1,7,9,0,"주소"],[55,22,1,3,9,0,"연락처"],[56,1,1,2,10,1,"갑"],[56,3,1,5,10,1],[56,8,1,4,10,1],[56,12,1,3,10,1],[56,15,1,7,11,1],[56,22,1,3,10,1],[57,1,1,2,10,1,"을"],[57,3,1,5,10,1],[57,8,1,4,10,1],[57,12,1,3,10,1],[57,15,1,7,11,1],[57,22,1,3,10,1],[59,1,1,24,6,0,"※ 이 계약서는 일반 양식입니다. 실제 체결 전에 반드시 검토를 받으시고, 정부가 고시한 표준계약서가 있는 계약은 그 원문을 사용하시는 편이 안전합니다."],[62,1,1,24,6,1,"          년        월        일",null,"yyyy\"년\" m\"월\" d\"일\""],[63,1,1,10,12,0,""],[63,11,1,6,13,0,"갑 (사업주)"],[63,17,1,4,6,1],[63,21,1,4,14,0,"(서명 또는 인)"],[64,1,1,10,12,0,""],[64,11,1,6,13,0,"을 (근로자)"],[64,17,1,4,6,1],[64,21,1,4,14,0,"(서명 또는 인)"]],"img":[],"notes":["노란 칸 = 요율·기준값(발주기관 기준으로 고쳐 씀) · 옅은 하늘색 칸 = 자동 계산(지우지 마세요) · 뒤 시트에 «작성 예시» 가 있습니다.","발주기관이 정한 서식이 있으면 그 서식을 쓰세요. 이 줄과 1행은 지워도 됩니다."],"brk":[],"keys":{"G5":"사업장(현장)명","G6":"근로장소","G7":"담당업무","G8":"근로계약기간","G9":"소정근로시간","G10":"휴게시간","G11":"휴일","G12":"연차유급휴가","G13":"임금(1일)","G14":"임금구성항목","G15":"임금계산방법","G16":"임금지급일","G17":"지급방법","A56":"구분#1","C56":"상호#1","H56":"등록#1","L56":"대표#1","O56":"주소#1","V56":"연락#1","A57":"구분#2","C57":"상호#2","H57":"등록#2","L57":"대표#2","O57":"주소#2","V57":"연락#2","A56:A57":"구분[]","C56:C57":"상호[]","H56:H57":"등록[]","L56:L57":"대표[]","O56:O57":"주소[]","V56:V57":"연락[]","A62":"서명일","Q63":"서명:갑(사업주)","Q64":"서명:을(근로자)"}}],"st":[{"b":1,"k":"0F203F","a":"left"},{"z":8.5,"k":"6B7280","a":"right"},{"z":19.0,"b":1,"k":"111827","a":"center","w":1},{"b":1,"g":"F3F5F9","a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"right","s":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"center","w":1},{"z":10.5,"b":1,"a":"left","w":1},{"a":"left","v":"top","w":1},{"b":1,"g":"E