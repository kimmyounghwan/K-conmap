{"v":1,"slug":"gy-dogeup","title":"공사도급계약서","sheets":[{"name":"공사도급계약서","exn":"작성 예시","w":[18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75,18.75],"h":[20.0,6.0,38.0,10.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,24.0,6.0,34.0,6.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,58.0,4.0,20.0,43.5,4.0,20.0,72.5,4.0,7.444444444444445,7.444444444444445,7.444444444444445,7.444444444444445,7.444444444444445,7.444444444444445,7.444444444444445,7.444444444444445,7.444444444444445,20.0,43.5,4.0,20.0,43.5,4.0,20.0,58.0,4.0,20.0,43.5,4.0,20.0,58.0,4.0,20.0,58.0,4.0,20.0,43.5,4.0,20.0,43.5,4.0,20.0,72.5,4.0,20.0,43.5,4.0,7.263888888888886,7.263888888888886,7.263888888888886,7.263888888888886,20.0,58.0,4.0,20.0,43.5,4.0,6.0,34.0,6.0,24.0,22.0,22.0,6.0,34.0,6.0,10.0,26.0,24.0,24.0,6.0,15.0,34.0,34.0,19.5],"pc":24,"pr":94,"land":0,"fit":0,"marg":[0.3,0.3,0.4,0.4],"cells":[[1,1,1,12,0,0,"  K-건설맵  |  k-conmap.com  건설 서식"],[1,13,1,12,1,0,""],[3,1,1,24,2,0,"공 사 도 급 계 약 서"],[5,1,1,6,3,0,"  공 사 명"],[5,7,1,18,4,1],[6,1,1,6,3,0,"  공사 장소"],[6,7,1,18,4,1],[7,1,1,6,3,0,"  공사 기간"],[7,7,1,18,4,1],[8,1,1,6,3,0,"  계약 금액"],[8,7,1,18,5,1,null,null,"\"₩\"#,##0\" (부가세 포함)\";;\"\""],[9,1,1,6,3,0,"  부가가치세"],[9,7,1,18,6,2,null,"IF(N(G8)=0,\"\",G8-ROUND(G8/1.1,0))","#,##0\"원 (계약금액에 포함)\";;\"\""],[10,1,1,6,3,0,"  계약보증금"],[10,7,1,4,7,1,null,null,"0%"],[10,11,1,14,6,2,null,"IF(OR(N(G8)=0,N(G10)=0),\"\",INT(ROUND(G8*G10,6)))","#,##0;[Red]-#,##0;\"\""],[11,1,1,6,3,0,"  지체상금률"],[11,7,1,18,4,1],[12,1,1,6,3,0,"  하자담보책임기간"],[12,7,1,18,4,1],[13,1,1,6,3,0,"  대금 지급방법"],[13,7,1,18,4,1],[15,1,1,24,8,0,"발주자(이하 「갑」)와 수급인(이하 「을」)은 위 공사에 관하여 다음과 같이 계약을 체결한다."],[17,1,1,24,9,0,"제1조 (목적)"],[18,1,1,24,10,0,"갑은 위 공사를 을에게 도급하고, 을은 설계도서·시방서 및 이 계약에서 정한 바에 따라 공사를 완성하며, 갑은 그 대가를 지급한다."],[20,1,1,24,9,0,"제2조 (계약금액과 지급)"],[21,1,1,24,10,0,"계약금액은 위에 적은 금액으로 하며, 부가가치세의 포함 여부는 위 표에 따른다. 갑은 선금·기성금·준공금을 위 지급방법에 따라 지급한다."],[23,1,1,24,9,0,"제3조 (공사기간)"],[24,1,1,24,10,0,"공사기간은 위에 적은 기간으로 한다. 갑의 사정, 천재지변, 을의 책임 없는 사유로 공사가 지연된 경우 을은 그 사유와 기간을 적어 공사기간 연장을 요청할 수 있고, 갑은 정당한 사유가 없으면 이에 응한다."],[26,1,1,24,9,0,"제4조 (착공과 시공)"],[27,1,1,24,10,0,"을은 착공 전에 착공계·현장대리인 지정서·공정표를 갑에게 제출한다. 을은 설계도서와 관계 법령에 따라 성실히 시공한다."],[29,1,1,24,9,0,"제5조 (설계변경)"],[30,1,1,24,10,0,"설계도서와 현장 상태가 다르거나 갑이 공사 내용의 변경을 요구한 때에는 을은 지체 없이 서면으로 보고하고, 갑과 을은 변경 내용과 계약금액·공사기간의 조정을 서면으로 합의한다. 서면 합의 없이 시공한 부분에 대하여는 대가를 청구할 수 없다."],[41,1,1,24,9,0,"제6조 (물가변동)"],[42,1,1,24,10,0,"계약 체결 후 자재·노무비 등이 현저히 변동한 때에는 갑 또는 을은 계약금액의 조정을 요청할 수 있고, 양측은 성실히 협의한다."],[44,1,1,24,9,0,"제7조 (감독과 검사)"],[45,1,1,24,10,0,"갑 또는 갑이 지정한 자는 공사 진행을 감독하고 검사할 수 있다. 을은 이에 협조하고, 부적합한 부분은 을의 부담으로 시정한다."],[47,1,1,24,9,0,"제8조 (기성 대가)"],[48,1,1,24,10,0,"을은 기성부분에 대하여 검사를 요청하고, 검사에 합격한 부분의 대가를 청구할 수 있다. 갑은 청구를 받은 날부터 위 지급방법에서 정한 기한 안에 지급한다."],[50,1,1,24,9,0,"제9조 (준공검사와 준공 대가)"],[51,1,1,24,10,0,"을은 공사를 마친 때에 준공계를 제출하고 갑의 준공검사를 받는다. 검사에 합격한 때에 준공한 것으로 보며, 갑은 준공 대가를 지급한다."],[53,1,1,24,9,0,"제10조 (지체상금)"],[54,1,1,24,10,0,"을의 책임 있는 사유로 준공이 늦어진 때에는 을은 지체일수에 계약금액과 위 지체상금률을 곱한 금액을 갑에게 지급한다. 다만 을의 책임 없는 사유로 인한 지연일수는 제외한다."],[56,1,1,24,9,0,"제11조 (하자담보책임)"],[57,1,1,24,10,0,"을은 준공일부터 위 하자담보책임기간 동안 시공상 하자를 무상으로 보수한다. 다만 갑의 사용상 과실, 천재지변 등 을의 책임 없는 사유로 생긴 하자는 그러하지 아니하다."],[59,1,1,24,9,0,"제12조 (안전과 보험)"],[60,1,1,24,10,0,"을은 산업안전보건 관계 법령을 지키고 필요한 안전조치를 한다. 을은 산재보험·고용보험에 가입하고 그 증명을 갑에게 제출한다."],[62,1,1,24,9,0,"제13조 (권리·의무의 양도 금지)"],[63,1,1,24,10,0,"을은 갑의 서면 동의 없이 이 계약상 권리·의무를 제3자에게 양도하거나 공사를 일괄 하도급할 수 없다."],[65,1,1,24,9,0,"제14조 (계약의 해제·해지)"],[66,1,1,24,10,0,"다음 각 호의 경우 상대방은 서면으로 최고한 후 계약을 해제 또는 해지할 수 있다. 1. 정당한 사유 없이 착공하지 아니하거나 공사를 중단한 때 2. 계약 조건을 위반하여 계약의 목적을 달성할 수 없게 된 때 3. 파산·회생절차 개시 등으로 계약 이행이 어렵게 된 때"],[68,1,1,24,9,0,"제15조 (손해배상)"],[69,1,1,24,10,0,"갑 또는 을이 이 계약을 위반하여 상대방에게 손해를 입힌 때에는 그 손해를 배상한다."],[75,1,1,24,9,0,"제16조 (분쟁의 해결)"],[76,1,1,24,10,0,"이 계약에 관한 분쟁은 갑과 을이 협의하여 해결하되, 협의가 이루어지지 아니한 때에는 건설분쟁 조정기구의 조정 또는 관할 법원의 판결에 따른다."],[78,1,1,24,9,0,"제17조 (특약사항)"],[79,1,1,24,10,0,"                                                                 "],[82,1,1,24,8,0,"이 계약을 증명하기 위하여 계약서 2통을 작성하여 갑과 을이 각각 기명날인한 후 1통씩 보관한다."],[84,1,1,2,11,0,"구분"],[84,3,1,5,11,0,"상호(성명)"],[84,8,1,4,11,0,"사업자등록번호"],[84,12,1,3,11,0,"대표자"],[84,15,1,7,11,0,"주소"],[84,22,1,3,11,0,"연락처"],[85,1,1,2,12,1,"갑"],[85,3,1,5,12,1],[85,8,1,4,12,1],[85,12,1,3,12,1],[85,15,1,7,13,1],[85,22,1,3,12,1],[86,1,1,2,12,1,"을"],[86,3,1,5,12,1],[86,8,1,4,12,1],[86,12,1,3,12,1],[86,15,1,7,13,1],[86,22,1,3,12,1],[88,1,1,24,8,0,"※ 이 계약서는 일반 양식입니다. 실제 체결 전에 반드시 검토를 받으시고, 정부가 고시한 표준계약서가 있는 계약은 그 원문을 사용하시는 편이 안전합니다."],[91,1,1,24,8,1,"          년        월        일",null,"yyyy\"년\" m\"월\" d\"일\""],[92,1,1,10,14,0,""],[92,11,1,6,15,0,"갑 (발주자)"],[92,17,1,4,8,1],[92,21,1,4,16,0,"(서명 또는 인)"],[93,1,1,10,14,0,""],[93,11,1,6,15,0,"을 (수급인)"],[93,17,1,4,8,1],[93,21,1,4,16,0,"(서명 또는 인)"]],"img":[],"notes":["계약 금액은 부가세를 포함해 적으면 부가가치세 칸이 저절로 나옵니다. 계약보증률(노란 칸)은 계약조건대로 고쳐 쓰세요.","노란 칸 = 요율·기준값(발주기관 기준으로 고쳐 씀) · 옅은 하늘색 칸 = 자동 계산(지우지 마세요) · 뒤 시트에 «작성 예시» 가 있습니다.","발주기관이 정한 서식이 있으면 그 서식을 쓰세요. 이 줄과 1행은 지워도 됩니다."],"brk":[],"keys":{"G5":"공사명","G6":"공사장소","G7":"공사기간","G8":"계약금액","G9":"부가가치세","G10":"보증률","K10":"계약보증금","G11":"지체상금률","G12":"하자담보책임기간","G13":"대금지급방법","A85":"구분#1","C85":"상호#1","H85":"등록#1","L85":"대표#1","O85":"주소#1","V85":"연락#1","A86":"구분#2","C86":"상호#2","H86":"등록#2","L86":"대표#2","O86":"주소#2","V86":"연락#2","A85:A86":"구분[]","C85:C86":"상호[]","H85:H86":"등록[]","L85:L86":"대표[]","O85:O86":"주소[]","V85:V86":"연락[]","A91":"서명일","Q92":"서명:갑(발주자)","Q93":"서명:을(수급인)"}}],"st":[{"b":1,"k":"0F203F","a":"left"},{"z":8.5,"k":"6B7280","a":"right"},{"z":19.0,"b":1,"k":"111827","a":"center","w":1},{"b":1,"g":"F3F5F9","a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"right","s":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"g":"EEF4FC","a":"right","s":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"g":"FFF1B8","a":"center","s":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"cente