w":[7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5,7.5],"h":[20.0,13.0,16.0,125.28,22.0,27.0,26.0,20.0,20.0,52.0,44.0,13.0,16.0,13.0,114.0,12.0,15.0,19.5],"pc":96,"pr":16,"land":1,"fit":1,"marg":[0.35,0.35,0.45,0.45],"cells":[[1,1,1,48,0,0,"  K-건설맵  |  k-conmap.com  건설 서식"],[1,49,1,48,1,0,""],[2,1,1,96,17,0,"(3쪽 중 제3쪽)"],[3,1,1,96,54,0,"작성방법"],[4,1,1,47,55,0,"1. 하도급건설공사대장 통보(작성) 대상자는 하수급인이며 공동도급일 경우에는 공동수급체 대표사가 구성원 정보까지 모두 포함하여 적습니다.\n2. 건설공사대장에 적어야 하는 사항이 서식의 빈칸을 초과하는 경우에는 서식에 빈칸을 추가하여 적습니다(예: 공동도급수급체 구성원이 3인 이상인 경우 등)\n<항목별 설명>\n1.공사개요\n ① 공사유형: 신설공사 또는 유지보수공사를 말합니다. 이 경우 시설물의 완공 이후 개량ㆍ보수ㆍ보강하는 공사는 유지보수란에 적습니다. 다만, 건축물의 증축ㆍ개축ㆍ재축 및 대수선공사와 건축물을 제외한 그 밖의 시설물의 증설ㆍ확장공사 및 주요구조부를 해체한 후 복구ㆍ보강ㆍ변경하는 공사는 신설공사와 같이 신설란에 적습니다.\n ② 공사종류\n - 종합공사"],[4,48,12,49,56,0," ③ 연락처: 발주자 담당자의 전자우편 또는 전화번호(휴대전화번호를 포함합니다)\n\n2. 하도급 계약내용\n ④ 보증금:\n   - 보증종류: 계약보증, 공사이행보증, 선급금보증, 하자보수보증\n   - 예치방법: 현금, 유가증권, 보증서 등\n   - 비고: 보증서를 발급한 경우 보증서번호, 보증기관, 발급업체, 발급일자를 그 외 방법인 경우 예치업체를 적습니다.\n\n3. 공사대금 및 공사진척사항\n ⑤ 지분율 또는 분담내용(공동도급의 경우): 「건설산업기본법」 제29조의2에 따른 하도급관리를 위해 하도급 구성원 간에 체결한 공동수급협정서를 스캔 파일로 첨부합니다.\n ⑥ 세금계산서 발행금액: 세금계산서상의 공급가액 및 세액을 포함한 금액입니다.\n\n4. 공사참여자 현황\n ⑦ 발주자승낙여부: 「건설산업기본법 시행령」 제35조제3항 각 호에 해당하는 공사로 발주자의 승낙을 받아 1명의 건설기술인을 2개 이상의 공사현장에 배치하는 경우 및 「건설산업기본법」 제40조제1항 단서에 따라 같은 법 시행규칙 제30조의2 각 호의 경우에 해당되어 발주자의 서면 승낙을 받아 건설기술인을 배치하지 않은 경우에 기재하며, 그 발주자 서면 승낙서를 스캔 파일로 첨부합니다.\n ⑧ 하도급대금지급보증서: 「건설산업기본법 시행규칙」 제25조의7제2호가목에 따라 하도급업체가 재하도급업체에게 공사대금의 지급을 보증하는 보증서를 교부한 경우, 보증서번호, 보증기관, 발급일자를 적습니다.\n ⑨ 재하도급사유: 「건설산업기본법」 제29조제3항 및 같은 법 시행규칙 제25조의7에 따른 재하도급사유를 적습니다.\n ⑩ 수급인서면승낙서: 「건설산업기본법」 제29조제3항제2호에 따른 수급인서면승낙서를 스캔 파일로 첨부합니다.\n ⑪ 건설기계명: 「건설기계관리법 시행령」 별표 1에 따른 건설기계\n ⑫ 대여기간 및 ⑬ 대여금액: 월대 또는 일대로 지급되더라도 전체 대여기간 및 전체 대여금액을 기준으로 적습니다."],[5,1,1,3,48,0,"공사\n종류"],[5,4,1,4,48,0,"공종그룹\n종류"],[5,8,1,40,48,0,"세부공사종류(종합)"],[6,1,3,3,40,0,"토목"],[6,4,1,4,40,0,"1. 교통\n시설"],[6,8,1,9,57,0,"일반도로\n고속화도로\n고속도로"],[6,17,1,10,58,0,"도로교량\n철도교량\n공항"],[6,27,1,11,58,0,"일반철도\n고속철도\n지하철"],[6,38,1,10,59,0,"도로터널\n철도터널"],[7,4,1,4,40,0,"2. 수자원\n시설"],[7,8,1,9,57,0,"댐\n항만\n운하"],[7,17,1,10,58,0,"치수ㆍ하천\n수로터널"],[7,27,1,11,58,0,"관개수로\n상수도(1천㎜ 이상)\n상수도(1천㎜ 미만)"],[7,38,1,10,59,0,"정수장\n하수도"],[8,4,1,4,40,0,"3. 기타\n토목시설"],[8,8,1,9,57,0,"간척\n농지정리"],[8,17,1,10,58,0,"택지조성\n공업용지조성"],[8,27,1,11,58,0,"치산ㆍ사방\n기타터널"],[8,38,1,10,59,0,"기타토목시설"],[9,1,2,3,40,0,"건축"],[9,4,1,4,40,0,"1. 주거\n시설"],[9,8,1,9,57,0,"단독주택ㆍ연립주택\n저층아파트(5층 이하)"],[9,17,1,10,58,0,"고층아파트(6층~15층 이하)\n초고층아파트(16층 이상)"],[9,27,1,11,58,0,"주상복합건축물"],[9,38,1,10,59,0,""],[10,4,1,4,40,0,"2. 비주거\n시설"],[10,8,1,9,57,0,"상가ㆍ백화점ㆍ쇼핑센터\n사무실빌딩\n오피스텔\n인텔리전트빌딩\n호텔ㆍ숙박시설\n관공서건물(11층 이하)"],[10,17,1,10,58,0,"관공서건물(12층 이상)\n학교\n병원\n전통양식건축\n교회ㆍ사찰 등 종교용건물\n기타문화유산ㆍ유적건물"],[10,27,1,11,58,0,"공연집회시설\n경기장ㆍ운동장\n전시(展示)시설\n창고ㆍ차고ㆍ터미널건물\n공장ㆍ작업장용건물\n기계기구시설(플랜트 제외)"],[10,38,1,10,59,0,"위험물저장소\n변전소ㆍ발전소용건물\n기타건축시설"],[11,1,1,7,40,0,"산업ㆍ환경설비"],[11,8,1,9,57,0,"제철소ㆍ석유화학공장 등 산업생산시설\n원자력발전소\n화력발전소\n열병합발전소"],[11,17,1,10,58,0,"수력발전소\n태양광발전소\n풍력발전소\n조력발전소\n(집단에너지공급시설)송유관"],[11,27,1,11,58,0,"(집단에너지공급시설)유류저장시설\n(집단에너지공급시설)가스관\n(집단에너지공급시설)가스저장시설\n쓰레기소각장"],[11,38,1,10,59,0,"하수종말처리장\n폐수종말처리장\n기타환경시설공사\n기타플랜트설비공사"],[12,1,1,7,40,0,"조경"],[12,8,1,9,57,0,"수목원"],[12,17,1,10,58,0,"공원"],[12,27,1,11,58,0,"기타조경공사"],[12,38,1,10,59,0,""],[13,1,1,47,60,0," - 전문공사"],[14,1,1,47,48,0,"세부공사종류(전문)"],[15,1,1,12,61,0,"일반실내건축공사\n목재창호ㆍ목재구조물공사\n일반토공사\n발파공사\n미장공사\n타일공사\n방수공사\n조적공사\n석공사\n일반도장공사\n재(再)도장공사\n차선도색공사\n비계공사"],[15,13,1,11,61,0,"파일공사\n구조물해체공사\n창호공사\n금속구조물공사\n온실설치공사\n지붕ㆍ판금공사\n건축물조립공사\n철근ㆍ콘크리트공사\n건축기계설비공사\n플랜트기계설비공사\n자동제어공사\n상수도설비공사\n하수도설비공사"],[15,24,1,12,61,0,"일반보링ㆍ그라우팅공사\n착정공사(지하수개발공사)\n철도ㆍ궤도공사\n일반포장공사\n포장유지관리공사\n수중공사\n일반조경식재공사\n조경유지관리공사\n조경시설물설치공사\n일반강구조물공사\n인도전용강재육교설치공사\n일반철강재설치공사\n교량철구조물설치공사"],[15,36,1,