1,24,7,0,"제7조 (퇴직급여)"],[46,1,1,24,8,0,"퇴직급여는 관계 법령에 따른다."],[48,1,1,24,7,0,"제8조 (성실 의무)"],[49,1,1,24,8,0,"을은 갑의 취업규칙과 지시를 따르고 직무상 알게 된 비밀을 지킨다."],[51,1,1,24,7,0,"제9조 (계약서의 교부)"],[52,1,1,24,8,0,"갑은 이 계약서를 2통 작성하여 1통을 을에게 준다."],[54,1,1,24,7,0,"제10조 (그 밖의 사항)"],[55,1,1,24,8,0,"이 계약에 정하지 아니한 사항은 취업규칙과 근로기준법 등 관계 법령에 따른다."],[58,1,1,2,9,0,"구분"],[58,3,1,5,9,0,"상호(성명)"],[58,8,1,4,9,0,"사업자등록번호"],[58,12,1,3,9,0,"대표자"],[58,15,1,7,9,0,"주소"],[58,22,1,3,9,0,"연락처"],[59,1,1,2,10,1,"갑"],[59,3,1,5,10,1],[59,8,1,4,10,1],[59,12,1,3,10,1],[59,15,1,7,11,1],[59,22,1,3,10,1],[60,1,1,2,10,1,"을"],[60,3,1,5,10,1],[60,8,1,4,10,1],[60,12,1,3,10,1],[60,15,1,7,11,1],[60,22,1,3,10,1],[62,1,1,24,6,0,"※ 이 계약서는 일반 양식입니다. 실제 체결 전에 반드시 검토를 받으시고, 정부가 고시한 표준계약서가 있는 계약은 그 원문을 사용하시는 편이 안전합니다."],[65,1,1,24,6,1,"          년        월        일",null,"yyyy\"년\" m\"월\" d\"일\""],[66,1,1,10,12,0,""],[66,11,1,6,13,0,"갑 (사업주)"],[66,17,1,4,6,1],[66,21,1,4,14,0,"(서명 또는 인)"],[67,1,1,10,12,0,""],[67,11,1,6,13,0,"을 (근로자)"],[67,17,1,4,6,1],[67,21,1,4,14,0,"(서명 또는 인)"]],"img":[],"notes":["노란 칸 = 요율·기준값(발주기관 기준으로 고쳐 씀) · 옅은 하늘색 칸 = 자동 계산(지우지 마세요) · 뒤 시트에 «작성 예시» 가 있습니다.","발주기관이 정한 서식이 있으면 그 서식을 쓰세요. 이 줄과 1행은 지워도 됩니다."],"brk":[],"keys":{"G5":"사업장명","G6":"근무장소","G7":"담당업무","G8":"계약형태","G9":"근로계약기간","G10":"수습기간/임금","G11":"소정근로시간","G12":"휴게시간","G13":"휴일","G14":"연차유급휴가","G15":"임금(월)","G16":"임금구성항목","G17":"연장·야간·휴일수당","G18":"임금지급일","G19":"지급방법","A59":"구분#1","C59":"상호#1","H59":"등록#1","L59":"대표#1","O59":"주소#1","V59":"연락#1","A60":"구분#2","C60":"상호#2","H60":"등록#2","L60":"대표#2","O60":"주소#2","V60":"연락#2","A59:A60":"구분[]","C59:C60":"상호[]","H59:H60":"등록[]","L59:L60":"대표[]","O59:O60":"주소[]","V59:V60":"연락[]","A65":"서명일","Q66":"서명:갑(사업주)","Q67":"서명:을(근로자)"}}],"st":[{"b":1,"k":"0F203F","a":"left"},{"z":8.5,"k":"6B7280","a":"right"},{"z":19.0,"b":1,"k":"111827","a":"center","w":1},{"b":1,"g":"F3F5F9","a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"left","w":1,"bd":["1#5B6573","1#5B6573","1#5B6573","1#5B6573"]},{"a":"r